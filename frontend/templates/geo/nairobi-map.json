arani"},{"id":"university-of-nairobi","name":"University of Nairobi","category":"education","x":-37,"y":-114,"lat":-1.27972,"lon":36.81667,"description":"Kenya's oldest university. The main campus sits beside the CBD.","constituency":"starehe"},{"id":"strathmore-university","name":"Strathmore University","category":"education","x":-74,"y":221,"lat":-1.31,"lon":36.81333,"description":"Private university in Madaraka, off Ole Sangale Road.","constituency":"langata"},{"id":"usiu-africa","name":"USIU-Africa","category":"education","x":659,"y":-795,"lat":-1.21806,"lon":36.8792,"description":"United States International University - Africa, a private university off Thika Road.","constituency":"roysambu"},{"id":"kenyatta-national-hospital","name":"Kenyatta National Hospital","category":"health","x":-145,"y":118,"lat":-1.30069,"lon":36.80699,"description":"Kenya's largest public referral and teaching hospital, off Ngong Road.","constituency":"kibra"},{"id":"aga-khan-university-hospital","name":"Aga Khan University Hospital","category":"health","x":46,"y":-317,"lat":-1.26131,"lon":36.82414,"description":"Private hospital on 3rd Parklands Avenue.","constituency":"westlands"},{"id":"the-nairobi-hospital","name":"The Nairobi Hospital","category":"health","x":-170,"y":68,"lat":-1.29611,"lon":36.80472,"description":"Private hospital on Argwings Kodhek Road, in Upper Hill.","constituency":"kibra"},{"id":"jamia-mosque","name":"Jamia Mosque","category":"faith","x":8,"y":-71,"lat":-1.28362,"lon":36.82069,"description":"Nairobi's principal mosque, on Banda Street in the CBD.","constituency":"starehe"},{"id":"holy-family-basilica","name":"Holy Family Basilica","category":"faith","x":8,"y":-31,"lat":-1.2872,"lon":36.8207,"description":"Roman Catholic cathedral on City Hall Way.","constituency":"starehe"},{"id":"all-saints-cathedral","name":"All Saints Cathedral","category":"faith","x":-73,"y":-7,"lat":-1.28933,"lon":36.81344,"description":"Anglican cathedral on Kenyatta Avenue, beside Uhuru Park.","constituency":"dagoretti-north"},{"id":"nyayo-national-stadium","name":"Nyayo National Stadium","category":"sport","x":50,"y":157,"lat":-1.30419,"lon":36.82447,"description":"Stadium where Lang'ata Road meets Mombasa Road.","constituency":"langata"},{"id":"kasarani-stadium","name":"Kasarani Stadium","category":"sport","x":785,"y":-685,"lat":-1.22806,"lon":36.89056,"description":"The Moi International Sports Centre, Kenya's largest stadium, off Thika Road.","constituency":"kasarani"},{"id":"ngong-racecourse","name":"Ngong Racecourse","category":"sport","x":-856,"y":218,"lat":-1.30972,"lon":36.74306,"description":"Nairobi's horse-racing course, on Ngong Road.","constituency":"langata"}],"neighbourhoods":[{"name":"CBD","x":19,"y":-40,"rank":1,"constituency":"starehe"},{"name":"Westlands","x":-150,"y":-260,"rank":1,"constituency":"westlands","rent":4},{"name":"Kilimani","x":-425,"y":66,"rank":1,"constituency":"dagoretti-north","rent":4},{"name":"Karen","x":-1280,"y":424,"rank":1,"constituency":"langata","rent":5},{"name":"Eastleigh","x":322,"y":-173,"rank":1,"constituency":"kamukunji","rent":2},{"name":"Kasarani","x":701,"y":-857,"rank":1,"constituency":"roysambu","rent":2},{"name":"Embakasi","x":1271,"y":195,"rank":1,"constituency":"embakasi-east","rent":2},{"name":"Kileleshwa","x":-357,"y":-147,"rank":2,"constituency":"dagoretti-north","rent":4},{"name":"Lavington","x":-487,"y":-176,"rank":2,"constituency":"dagoretti-north","rent":4},{"name":"Lang'ata","x":-340,"y":291,"rank":2,"constituency":"langata","rent":3},{"name":"Parklands","x":-104,"y":-298,"rank":2,"constituency":"westlands","rent":4},{"name":"Gigiri","x":-141,"y":-636,"rank":2,"constituency":"westlands","rent":5},{"name":"Runda","x":-123,"y":-794,"rank":2,"constituency":"westlands","rent":5},{"name":"Muthaiga","x":112,"y":-408,"rank":2,"constituency":"westlands","rent":5},{"name":"Upper Hill","x":-79,"y":46,"rank":2,"constituency":"kibra","rent":4},{"name":"South B","x":197,"y":267,"rank":2,"con