37333,"lon":36.85889,"description":"Kenya's first national park, gazetted in 1946. Lions, rhino and giraffe with the city skyline behind them. The main gate is on Lang'ata Road.","constituency":"langata"},{"id":"karura-forest","name":"Karura Forest","category":"nature","x":40,"y":-550,"lat":-1.24028,"lon":36.82361,"description":"Roughly a thousand hectares of urban forest with walking, running and cycling trails and a waterfall. Managed by the Kenya Forest Service with Friends of Karura.","constituency":"westlands"},{"id":"uhuru-park","name":"Uhuru Park","category":"nature","x":-31,"y":3,"lat":-1.29028,"lon":36.81722,"description":"Public park on the edge of the CBD, with a boating lake. Central Park is next door.","constituency":"dagoretti-north"},{"id":"nairobi-arboretum","name":"Nairobi Arboretum","category":"nature","x":-77,"y":-174,"lat":-1.2743,"lon":36.8131,"description":"A tree park off State House Road, started in 1907 to trial tree species. Popular for picnics and early-morning runs.","constituency":"starehe"},{"id":"city-park","name":"City Park","category":"nature","x":111,"y":-291,"lat":-1.26365,"lon":36.82997,"description":"Forested public park between Parklands and Muthaiga, with walking paths and resident monkeys.","constituency":"westlands"},{"id":"ngong-road-forest","name":"Ngong Road Forest","category":"nature","x":-871,"y":292,"lat":-1.31642,"lon":36.7417,"description":"Forest reserve between Ngong Road and Karen, with trails for walking, running and riding.","constituency":"langata"},{"id":"giraffe-centre","name":"Giraffe Centre","category":"nature","x":-822,"y":952,"lat":-1.37612,"lon":36.7461,"description":"Run by the African Fund for Endangered Wildlife. Feed Rothschild's giraffes from a raised platform in Lang'ata.","constituency":"langata"},{"id":"sheldrick-wildlife-trust","name":"Sheldrick Wildlife Trust","category":"nature","x":-511,"y":958,"lat":-1.37664,"lon":36.7741,"description":"Orphaned elephant nursery inside Nairobi National Park. Visitors come for a short daily viewing; book ahead.","constituency":"langata"},{"id":"nairobi-national-museum","name":"Nairobi National Museum","category":"culture","x":-56,"y":-178,"lat":-1.27389,"lon":36.815,"description":"On Museum Hill: Kenyan history, culture, art and natural history, with the Snake Park in the same grounds.","constituency":"starehe"},{"id":"karen-blixen-museum","name":"Karen Blixen Museum","category":"culture","x":-1196,"y":685,"lat":-1.35197,"lon":36.71251,"description":"The farmhouse of Karen Blixen, author of Out of Africa, kept as a museum in Karen.","constituency":"langata"},{"id":"bomas-of-kenya","name":"Bomas of Kenya","category":"culture","x":-566,"y":518,"lat":-1.33681,"lon":36.7691,"description":"Traditional homesteads of Kenya's communities and regular dance performances, off Lang'ata Road.","constituency":"langata"},{"id":"nairobi-railway-museum","name":"Nairobi Railway Museum","category":"culture","x":24,"y":41,"lat":-1.29373,"lon":36.82219,"description":"Locomotives and carriages from the Uganda Railway era, beside the central station.","constituency":"starehe"},{"id":"kenya-national-theatre","name":"Kenya National Theatre","category":"culture","x":-49,"y":-127,"lat":-1.27853,"lon":36.81564,"description":"Theatre on Harry Thuku Road, next to the University of Nairobi.","constituency":"starehe"},{"id":"kenya-national-archives","name":"Kenya National Archives","category":"culture","x":66,"y":-57,"lat":-1.28489,"lon":36.82594,"description":"National records and a public gallery on Moi Avenue, facing the Hilton.","constituency":"starehe"},{"id":"nairobi-gallery","name":"Nairobi Gallery","category":"culture","x":-24,"y":-35,"lat":-1.28679,"lon":36.81783,"description":"Art gallery in the Old PC's Office at the corner of Kenyatta Avenue and Uhuru Highway.","constituency":"starehe"},{"id":"parliament-buildings","name":"Parliament Buildings","category":"government","x":-2,"y":0,"lat":-1.29003,"lon":36.81981,"description":"Seat of the National Assembly and the Senate, on Parliament Road.","constituency":"starehe"},{"id":"kicc","name":"KICC","category":"government","x":34,"y":-15,"lat":-1.28861,"lon":36.82306,"description":"The Kenyatta International Convention Centre. The cylindrical tower that defines the skyline, with a rooftop viewing deck.","constituency":"starehe"},{"id":"city-hall","name":"City Hall","category":"government","x":19,"y":-34,"lat":-1.2869,"lon":36.82175,"description":"Seat of the Nairobi City County government, on City Hall Way.","constituency":"starehe"},{"id":"supreme-court","name":"Supreme Court","category":"government","x":35,"y":-28,"lat":-1.28749,"lon":36.8231,"description":"Kenya's highest court, on City Hall Way.","constituency":"starehe"},{"id":"state-house","name":"State House","category":"government","x":-198,"y":-80,"lat":-1.28278,"lon":36.80222,"description":"The President's official residence. Not open to the public.","constituency":"dagoretti-north"},{"id":"un-office-at-nairobi","name":"UN Office at Nairobi","category":"government","x":-39,"y":-612,"lat":-1.23466,"lon":36.8165,"description":"UNON in Gigiri, headquarters of UNEP and UN-Habitat and the UN's main base in Africa.","constituency":"westlands"},{"id":"jomo-kenyatta-international-airport","name":"Jomo Kenyatta International Airport","category":"transport","x":1178,"y":316,"lat":-1.31861,"lon":36.92583,"description":"JKIA, Nairobi's main international airport, in Embakasi, south-east of the CBD.","constituency":"embakasi-east"},{"id":"wilson-airport","name":"Wilson Airport","category":"transport","x":-56,"y":332,"lat":-1.32,"lon":36.815,"description":"Domestic and light-aircraft airport on Lang'ata Road. Many safari flights to the Maasai Mara leave from here.","constituency":"langata"},{"id":"nairobi-terminus-sgr","name":"Nairobi Terminus (SGR)","category":"transport","x":873,"y":714,"lat":-1.35456,"lon":36.89843,"description":"Where Madaraka Express trains to Mombasa leave from, near Syokimau.","constituen