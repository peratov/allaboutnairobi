{% extends "_layout.html" %}
{% set canonical_path = "/map" %}
{% set metatitle = "Map of Nairobi: districts and landmarks" %}
{% set metadescription = "An interactive map of Nairobi's districts with population, characteristics, and landmarks. Explore Nairobi's geography." %}

{% set districts = MAP.districts %}
{% set landmarks = MAP.landmarks %}

{% block main %}
	<main id="main" class="wide-column" aria-label="Main page">
		<article class="section">
			<h1>Map of Nairobi</h1>
			<p class="page-intro">
				Nairobi's {{ districts|length }} districts and {{ landmarks|length }} landmarks.
				Every district has a 2019 census population count and informality rate.
				Tap anything to explore.
			</p>

			<nairobi-map data-clarity-mask="true"></nairobi-map>

			<noscript>
				<p class="tool-note">
					The map needs JavaScript. Everything on it is listed below, which
					is the same data.
				</p>
			</noscript>
		</article>

		<article class="section map-fallback">
			<h2 id="people">Districts of Nairobi</h2>
			<p>
				Population counts from the 2019 Kenya Census. The {{ districts|length }}
				districts below sum to
				{{ '{:,}'.format(districts|map(attribute='population')|sum) }} &mdash;
				the approximate total for Nairobi.
			</p>

			<div class="table-wrapper">
				<table>
					<thead>
						<tr>
							<th scope="col">District</th>
							<th scope="col">Population</th>
							<th scope="col">Informal %</th>
							<th scope="col">Characteristics</th>
						</tr>
					</thead>
					<tbody>
						{% for district in districts|sort(attribute='population', reverse=true) %}
							<tr>
								<th scope="row">{{ district.name }}</th>
								<td>{{ '{:,}'.format(district.population) }}</td>
								<td>{{ district.informalPct }}%</td>
								<td>{{ district.characteristics }}</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>

			<p class="map-hint">
				Nairobi's districts range from nearly 0% informal (Runda, Muthaiga) to over 80% (Njeru, Eastleigh).
			</p>
		</article>

		<article class="section map-fallback">
			<h2 id="landmarks">Landmarks and attractions</h2>
			<p>
				Nairobi has parks, museums, cultural sites, wildlife centers, and other landmarks worth exploring.
				Each landmark has a type and description.
			</p>

			<div class="table-wrapper">
				<table>
					<thead>
						<tr>
							<th scope="col">Landmark</th>
							<th scope="col">Type</th>
							<th scope="col">Description</th>
						</tr>
					</thead>
					<tbody>
						{% for landmark in landmarks %}
							<tr>
								<th scope="row">{{ landmark.name }}</th>
								<td>{{ landmark.type }}</td>
								<td>{{ landmark.description }}</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		</article>

		<article class="section">
			<h2 id="sources">Where this comes from</h2>
			<p>
				The districts and landmarks are drawn from OpenStreetMap data,
				with population figures from the Kenya National Bureau of Statistics (KNBS) 2019 Census.
			</p>
			<ul>
				<li>
					<strong>District boundaries and data</strong> &mdash;
					<a href="https://www.knbs.or.ke/" rel="noopener" target="_blank">Kenya National Bureau of Statistics</a>,
					2019 Population and Housing Census.
				</li>
				<li>
					<strong>Landmark coordinates</strong> &mdash;
					<a href="https://www.openstreetmap.org/copyright" rel="noopener" target="_blank">OpenStreetMap
					contributors</a>, ODbL.
				</li>
			</ul>
			<p class="map-hint">
				Data generated {{ now.strftime('%d %B %Y') }}.
			</p>

			<p>
				&mdash; <a href="{{ SITE_URL }}/guides">Guides to living in Nairobi &#8658;</a>
			</p>

			<p>
				<strong>The map is drawn here, not fetched.</strong> There is no tile
				server and no third party involved: it is one SVG built from a single
				file served by this site, so it costs one request, works on a slow
				connection, and does not tell anyone else where you are looking.
			</p>
		</article>

		{% include "_blocks/relatedGuides.html" ignore missing %}
	</main>
{% endblock %}
