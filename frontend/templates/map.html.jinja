{% extends "_layout.html" %}
{% set canonical_path = "/map" %}
{% set metatitle = "Map of Nairobi: constituencies, neighbourhoods and landmarks" %}
{% set constituencies = MAP.constituencies %}
{% set census = MAP.census %}
{% set landmarks = MAP.landmarks %}
{% set metadescription = "An interactive map of Nairobi: " ~ constituencies|length ~ " constituencies, " ~ landmarks|length ~ " landmarks, 2019 census population, age and gender, relative wealth and typical rents by neighbourhood." %}

{% block main %}
	<main id="main" class="wide-column" aria-label="Main page">
		<article class="section">
			<div class="section-heading">
				<span class="icon-stamp">{% include "_icons/exploring.svg" %}</span>
				<h1>Map of Nairobi</h1>
			</div>
			<p class="page-intro">
				Nairobi City County's {{ constituencies|length }} constituencies,
				the neighbourhoods inside them and {{ landmarks|length }} landmarks.
				Tap a constituency or a pin, search for a place, or switch layers to
				see population, age, gender and wealth across the city, and what rent
				looks like neighbourhood by neighbourhood.
			</p>

			<nairobi-map data-clarity-mask="true"></nairobi-map>

			<noscript>
				<p class="tool-note">
					The map needs JavaScript. Everything on it is in the tables below.
				</p>
			</noscript>
		</article>

		{% set by_wealth = constituencies|sort(attribute='rwi', reverse=true)|map(attribute='id')|list %}
		<article class="section map-fallback">
			<h2 id="constituencies">The constituencies</h2>
			<p>
				Nairobi had {{ '{:,}'.format(MAP.population) }} people at the 2019 census,
				on {{ MAP.county_area_km2|round|int }} km&sup2;. The constituency figures are
				<strong>estimates</strong>, rounded hard on purpose &mdash;
				<a href="#map-method">here is why</a>.
			</p>

			<div class="table-wrapper">
				<table>
					<thead>
						<tr>
							<th scope="col">Constituency</th>
							<th scope="col" class="numeric">People (est.)</th>
							<th scope="col" class="numeric">Area</th>
							<th scope="col" class="numeric">People per km&sup2; (est.)</th>
							<th scope="col" class="numeric">Relative wealth</th>
						</tr>
					</thead>
					<tbody>
						{% for c in constituencies|sort(attribute='density', reverse=true) %}
							<tr>
								<th scope="row"><a href="#constituency/{{ c.id }}">{{ c.name }}</a></th>
								<td class="numeric">{{ '{:,}'.format(c.population) }}</td>
								<td class="numeric">{{ c.areaKm2 }} km&sup2;</td>
								<td class="numeric">{{ '{:,}'.format(c.density) }}</td>
								<td class="numeric">{{ by_wealth.index(c.id) + 1 }} of {{ constituencies|length }}</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>

			<h2 id="census">What the census actually counted</h2>
			<p>
				The 2019 Kenya Population and Housing Census reports Nairobi by its
				{{ census|length }} administrative sub-counties. These are the real counts.
				Sub-counties are drawn on different lines from constituencies, so the two
				tables do not line up, even where the names match.
			</p>

			<div class="table-wrapper">
				<table>
					<thead>
						<tr>
							<th scope="col">Sub-county</th>
							<th scope="col" class="numeric">People</th>
							<th scope="col" class="numeric">Per km&sup2;</th>
							<th scope="col" class="numeric">Women</th>
							<th scope="col" class="numeric">Under 15</th>
							<th scope="col" class="numeric">20 to 34</th>
							<th scope="col" class="numeric">65 and over</th>
						</tr>
					</thead>
					<tbody>
						{% for s in census %}
							<tr>
								<th scope="row"><a href="#subcounty/{{ s.name|lower|replace("'", "")|replace(' ', '-') }}">{{ s.name }}</a></th>
								<td class="numeric">{{ '{:,}'.format(s.population) }}</td>
								<td class="numeric">{{ '{:,}'.format(s.density) }}</td>
								<td class="numeric">{{ s.femalePct }}%</td>
								<td class="numeric">{{ s.under15Pct }}%</td>
								<td class="numeric">{{ s.age20to34Pct }}%</td>
								<td class="numeric">{{ s.over64Pct }}%</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
			<p class="tool-note">
				Totals exclude the small number of people recorded as intersex, which is
				why they sum to {{ '{:,}'.format(MAP.population) }} rather than the
				headline 4,397,073.
			</p>
		</article>

		<article class="section map-fallback">
			<h2 id="rent">Typical rent, by neighbourhood</h2>
			<p>
				An indicative band for each neighbourhood, from our reading of 2026 rental
				listings. It is a judgement, not a measured index, and rents vary a great
				deal within any one area. Neighbourhoods we cannot place with confidence are
				left out rather than guessed.
			</p>
			<div class="table-wrapper">
				<table>
					<thead>
						<tr><th scope="col">Band</th><th scope="col">What it means</th><th scope="col">Neighbourhoods</th></tr>
					</thead>
					<tbody>
						{% for band, info in MAP.rent_bands.items()|reverse %}
							<tr>
								<th scope="row">{{ info.label }}</th>
								<td>{{ info.note }}</td>
								<td>{{ MAP.rent|selectattr('rent', 'equalto', band)|map(attribute='name')|join(', ') }}</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
			<p>&mdash; <a href="{{ SITE_URL }}/guides/finding-housing#rough-asking-rents">Rents and deposits in the housing guide &#8658;</a></p>
		</article>

		<article class="section map-fallback">
			<h2 id="landmarks">Landmarks on the map</h2>
			{% for key, label in MAP.categories.items() %}
				{% set group = landmarks|selectattr('category', 'equalto', key)|list %}
				{% if group %}
					<h3 id="landmarks-{{ key }}">{{ label }}</h3>
					<ul>
						{% for l in group %}
							<li><a href="#place/{{ l.id }}"><strong>{{ l.name }}</strong></a> &mdash; {{ l.description }}</li>
						{% endfor %}
					</ul>
				{% endif %}
			{% endfor %}
		</article>

		<article class="section">
			<h2 id="map-method">How the map is made</h2>
			<p>
				<strong>Boundaries</strong> are the IEBC's 17 constituencies. They are the
				units people vote in and the ones most people know. Wards are too small
				to be useful at this scale.
			</p>
			<p>
				<strong>The population estimates</strong> start from the census total for
				the whole county. That total is then shared out between constituencies
				in proportion to WorldPop's modelled population inside each one. WorldPop
				works on a one-kilometre grid, and Mathare is under three square
				kilometres, so the estimates are rounded to the nearest ten thousand. Use
				them to compare constituencies, not to quote.
			</p>
			<p>
				<strong>The census layers use the census's own areas.</strong> The census
				counts Nairobi by 11 administrative sub-counties, which follow different
				lines from the constituencies. Rather than force its figures onto the wrong
				shapes, the census layers switch the map to sub-county boundaries, so every
				number on them is a real 2019 count.
			</p>
			<p>
				<strong>Relative wealth is a model, not income.</strong> Kenya publishes no
				income figures below county level. The wealth layer uses Meta's Relative
				Wealth Index, which estimates living standards from satellite imagery and
				other data on tiles about 2.4 km across, validated against household surveys.
				Each constituency's value is the average of its tiles, weighted by where
				people live. It ranks places against each other; it cannot tell you what
				anyone earns, and in the smallest constituencies it rests on one or two tiles.
			</p>
			<p>
				<strong>Rent is our judgement.</strong> There is no public rent index for
				Nairobi, so the rent layer shows indicative bands for the neighbourhoods we
				can place with confidence, matching the figures in the housing guide.
			</p>
			<p>
				<strong>The map is drawn here, not fetched.</strong> There is no tile
				server and no third party involved. It is one SVG built from one file on
				this site, so it works on a slow connection and does not tell anyone
				else where you are looking. "Show where I am" asks your browser for
				your location, uses it on your device, and sends it nowhere.
			</p>

			<h3 id="sources">Sources</h3>
			<table>
				<thead>
					<tr><th scope="col">What</th><th scope="col">Source</th><th scope="col">Licence</th></tr>
				</thead>
				<tbody>
					{% for source in MAP.sources %}
						<tr>
							<th scope="row">{{ source.what }}</th>
							<td><a href="{{ source.url }}" rel="noopener">{{ source.who }}</a></td>
							<td>{{ source.licence }}</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
			<p class="tool-note">Map data built {{ MAP.generated }}.</p>

			<p>
				&mdash; <a href="{{ SITE_URL }}/guides/neighbourhoods-of-nairobi">Nairobi's neighbourhoods, and who lives where &#8658;</a><br>
				&mdash; <a href="{{ SITE_URL }}/guides/finding-housing">Finding a place to live &#8658;</a><br>
				&mdash; <a href="{{ SITE_URL }}/guides/getting-around-nairobi">Getting around Nairobi &#8658;</a><br>
				&mdash; <a href="{{ SITE_URL }}/guides/things-to-do-in-nairobi">Things to do in Nairobi &#8658;</a>
			</p>
		</article>
	</main>

	<script type="module" src="/js/components/nairobi-map.mjs"></script>
{% endblock %}
