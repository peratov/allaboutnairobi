{% extends "_layout.html" %}
{% set canonical_path = "/data" %}
{% set metatitle = "Nairobi and Kenya in numbers" %}
{% set metadescription = "Population, economy, housing and daily life statistics for Nairobi and Kenya. Coming soon with comprehensive data." %}

{# Mirrors readable() in data-dashboard.mjs, so the tables and the charts read
   the same figure the same way. A GDP written out in full is eleven digits of
   noise; abbreviated, it is a number a reader can hold. #}
{% macro figure(value, unit) -%}
	{%- if value is none -%}
		&mdash;
	{%- else -%}
		{%- if unit == 'US$' %}${% endif -%}
		{%- set abs = value|abs -%}
		{%- if abs >= 1000000000 -%}
			{{ '{:,.1f}'.format(value / 1000000000) }}bn
		{%- elif abs >= 1000000 -%}
			{{ '{:,.1f}'.format(value / 1000000) }}m
		{%- elif abs >= 1000 -%}
			{{ '{:,.0f}'.format(value) }}
		{%- else -%}
			{{ value|number }}
		{%- endif -%}
		{%- if unit.startswith('%') %}%{% endif -%}
	{%- endif -%}
{%- endmacro %}

{% set share = INDICATORS.meta.accra_gdp_share %}
{% set accra = INDICATORS.series|selectattr('scope', 'equalto', 'accra')|list %}
{% set derived = INDICATORS.series|selectattr('scope', 'equalto', 'derived')|list %}
{% set national = INDICATORS.series|selectattr('scope', 'equalto', 'ghana')|list %}

{% block main %}
	<main id="main" class="wide-column" aria-label="Main page">
		<article class="section">
			<div class="section-heading">
				<span class="adinkra-stamp">{% include "_icons/accuracy.svg" %}</span>
				<h1>Nairobi and Kenya in numbers</h1>
			</div>

			<p class="page-intro">
				Comprehensive economic, demographic, and social statistics for Nairobi and Kenya.
				This section is being developed with real Kenya data and will include housing costs,
				population trends, employment, and economic indicators.
			</p>

			<div class="admonition info">
				<p class="admonition-title">Coming soon</p>
				<p>Kenya national statistics and Nairobi-specific data will be added in the next phase. In the meantime, see our <a href="{{ SITE_URL }}/guides">guides</a> for practical information about living in Nairobi.</p>
			</div>
		</article>

		<article class="section">
			<h2 id="nairobi-stats">Nairobi and Kenya statistics</h2>

			<p>
				We're compiling comprehensive statistics for Nairobi and Kenya, including population,
				housing costs, employment, and economic indicators. This data will be added in the next phase.
				For now, use our practical guides to understand living costs and requirements.
			</p>

			<p>Check back soon for detailed statistics and data visualizations.</p>
		</article>


		<article class="section">
			<h2 id="guides">Practical guides for living in Nairobi</h2>
			<p>
				Our guides provide practical, up-to-date information for anyone moving to or living in Nairobi:
			</p>
			<p>
				&mdash; <a href="{{ SITE_URL }}/guides/moving-to-nairobi">Moving to Nairobi &#8658;</a><br>
				&mdash; <a href="{{ SITE_URL }}/guides/finding-housing">Finding housing &#8658;</a><br>
				&mdash; <a href="{{ SITE_URL }}/guides/paye-and-taxes">PAYE and taxes &#8658;</a><br>
				&mdash; <a href="{{ SITE_URL }}/guides/opening-a-bank-account">Opening a bank account &#8658;</a><br>
				&mdash; <a href="{{ SITE_URL }}/map">Nairobi district map &#8658;</a><br>
				&mdash; <a href="{{ SITE_URL }}/flights">Flights from Nairobi &#8658;</a>
			</p>
		</article>
	</main>
{% endblock %}

{% block postFooter %}
	{#
		Queued before super(), like /map does it. The layout's alljs runs inside
		super() and emits everything queued to that point, so this rides along
		in the one module script rather than adding a second one.
	#}
	{{ super() }}
{% endblock %}
