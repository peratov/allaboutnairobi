{% extends "_layout.html" %}
{% set page_robots = "noindex, follow" %}
{% set metatitle = "Search" %}
{% set metadescription = "Search every All About Accra guide, tool and glossary term." %}

{% block main %}
	<main id="main" class="single-column" aria-label="Main page">
		<article class="section">
			<h1>Search</h1>
			<p class="page-intro">
				The whole index is downloaded once and searched on your device, so results
				appear as you type and nothing you search for leaves your phone.
			</p>

			<form class="search-form" role="search" id="search-page-form" style="max-width: 32rem; font-size: 1.05rem">
				<label class="visually-hidden" for="search-page-input">Search terms</label>
				<input id="search-page-input" type="search" name="q" placeholder="Rent advance, SSNIT, trotro..." autocomplete="off" autofocus>
				<button type="submit" aria-label="Search">{% include "_icons/search.svg" %}</button>
			</form>

			<p id="search-status" role="status" aria-live="polite" style="color: var(--c-text-light); font-size: var(--f-s)"></p>
			<ul class="entry-previews" id="search-results"></ul>
		</article>
	</main>
{% endblock %}

{% block postFooter %}
	{{ super() }}
	<script type="module">
		import initializeSearch from '/js/components/search.mjs';
		initializeSearch();
	</script>
{% endblock %}
