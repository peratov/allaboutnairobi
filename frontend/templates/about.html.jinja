{% extends "_page.html" %}

{% block postcontent %}
	<aside class="section" aria-labelledby="h-symbols">
		<h2 id="h-symbols">The symbols on this site</h2>
		<p class="page-intro">
			The icons are <em>adinkra</em> &mdash; Akan ideograms, stamped onto cloth
			with a calabash dye stamp. Each one carries a proverb, so they are chosen
			here for what they say, not for what they look like. Hover any symbol on
			the site to read its meaning.
		</p>

		<ul class="symbol-legend">
			{% for slug, symbol in ADINKRA.items() %}
				<li>
					{% include "_icons/" + slug + ".svg" %}
					<span class="symbol-name">{{ symbol.symbol }}</span>
					<span class="symbol-meaning">{{ symbol.meaning }}</span>
				</li>
			{% endfor %}
		</ul>

		<p class="tool-note">
			Symbol artwork from the
			<a href="https://github.com/JacobTheEvans/adinkra">adinkra</a> project by
			Jacob Evans, used under the Apache License 2.0. The symbols themselves are
			traditional Akan and belong to no one.
		</p>
	</aside>
{% endblock %}
