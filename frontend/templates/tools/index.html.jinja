{% extends "_layout.html" %}
{% set page_styles = ['tools-page'] %}
{% set canonical_path = "/tools" %}
{% set metatitle = "Calculators and templates" %}
{% set metadescription = "Free Kenyan calculators - take-home pay, household staff, move-in costs, loans, stamp duty and VAT - plus tenancy, receipt and resignation templates." %}
{% set collections = get_entries('collections')|selectattr('type', 'equalto', 'tools')|list %}

{#
	The page is grouped by what a reader is trying to do, not by the
	collections - "Calculators" had grown to twenty-five things. Every tool
	still comes from collections.yaml (plus the comparers, planner, phrasebook
	and documents, which no collection lists); this only says which group it
	sits in, its symbol, what kind of tool it is, and one line written for the
	card (the front matter's description is written for a search result, and
	was cut off mid-sentence here).

	A tool added to a collection and not listed here lands in "More", so it is
	never left off the page.
#}
{% set tool_groups = [
	('money', 'Money, tax and banking', 'money', 'Pay, tax, savings, loans, and sending money in and out of Kenya.'),
	('work', 'Work and employing people', 'services', 'What you are owed, what staff cost, and the leave and overtime the law sets.'),
	('home', 'Home, property and where to live', 'housing', 'Moving in, a month in Nairobi, and buying, letting or selling property.'),
	('trade', 'Importing and business', 'shopping', 'What goods and cars cost to land, and the tax on a small business.'),
	('life', 'School, Swahili and AFCON 2027', 'culture', 'KCSE grades, everyday Swahili, and planning a match or a fan trip.'),
	('docs', 'Paperwork and documents', 'identity', 'Step-by-step plans, and templates and checklists to copy, fill in and print.'),
] %}
