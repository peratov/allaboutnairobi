{% extends "_layout.html" %}
{% set page_styles = ['tool-index'] %}
{% set canonical_path = "/tools" %}
{% set metatitle = "Calculators and templates" %}
{% set metadescription = "Free Kenyan calculators - take-home pay, household staff, move-in costs, loans, stamp duty and VAT - plus tenancy, receipt and resignation templates." %}
{% set docs = get_entries('docs', sort_by='title') %}
{% set collections = get_entries('collections')|selectattr('type', 'equalto', 'tools')|list %}

{#
	The interactive pages that are not calculators. They are standalone
	templates, so no collection lists them, and this page - where somebody
	looking for something to use rather than read ends up - never linked to any
	of them. Counts come from the same data the pages draw.
#}
{% set live_pages = [
	{'url': '/afcon', 'title': 'AFCON 2027 in Nairobi',
	 'text': 'A live countdown, the three stadiums, key dates you can add to your calendar, and a fan phrasebook.'},
	{'url': '/seasons', 'title': "What's in season in Nairobi",
	 'text': AGRICULTURE['items']|length ~ ' foods month by month, from mangoes to omena: what is good now, what is coming, and where it is grown.'},
	{'url': '/data', 'title': 'Nairobi and Kenya in numbers',
	 'text': INDICATORS.series|length ~ ' series charted over sixty years - population, the economy, schooling and daily life - with Nairobi and Kenya kept apart.'},
	{'url': '/map', 'title': 'Map of Nairobi',
	 'text': 'All ' ~ MAP.constituencies|length ~ ' constituencies and ' ~ MAP.landmarks|length ~ ' landmarks, shaded by population, wealth and rent.'},
	{'url': '/flights', 'title': 'Nonstop flights from Nairobi',
	 'text': 'All ' ~ FLIGHTS.destinations|length ~ ' destinations from JKIA on one map, with the airlines that fly each route.'},
	{'url': '/radio', 'title': 'Nairobi radio, live',
	 'text': 'Listen to ' ~ RADIO.stations|selectattr('stream')|list|length ~ ' Nairobi stations in your browser, with their frequencies.'},
	{'url': '/events', 'title': 'Events in Nairobi',
	 'text': 'Festivals, matches, public holidays and the fixtures that come round every year.'},
] %}
{# Nairobi Pulse and lost and found are listed before they open, saying so. #}
{% set live_pages = live_pages + [
	{'url': '/pulse', 'title': 'Nairobi Pulse' ~ ('' if PULSE_LIVE else ' (opening soon)'),
	 'text': 'Vote on questions about the city from inside Nairobi, and see on a live map how each of the ' ~ MAP.constituencies|length ~ ' constituencies answers.'},
	{'url': '/lost-and-found', 'title': 'Lost and found' ~ ('' if LOSTFOUND_LIVE else ' (opening soon)'),
	 'text': 'List something you lost or found in Nairobi, free. Your number is never shown.'},
] %}

{% macro toolCard(url, title, text) %}
	<li>
		<a class="tool-card" href="{{ url }}">
			<span class="tool-card-title">{{ title }}</span>
			{% if text %}<span class="tool-card-text">{{ text }}</span>{% endif %}
		</a>
	</li>
{% endmacro %}

{% block main %}
	<main id="main" class="wide-column" aria-label="Main page">
		<article class="section">
			<div class="section-heading">
				<span class="icon-stamp">{% include "_icons/tools.svg" %}</span>
				<h1>Calculators and templates</h1>
			</div>
			<p class="page-intro">
				Calculators that use the same figures as the guides, and documents you
				can copy and adapt. Nothing you type is sent anywhere &mdash; every sum
				happens on your own device.
			</p>

			{#
				Each tool says what it does. The list was sixteen bare names, and
				"withholding tax calculator" means nothing to somebody who has not
				yet been told they owe one.
			#}
			{% for collection in collections %}
				<section class="tool-group" id="{{ collection.id }}">
					<h2 class="tool-group-title">
						<span class="icon-stamp">{% include "_icons/" + collection.symbol + ".svg" %}</span>
						{{ collection.title }}
					</h2>
					{% if collection.description|default %}<p class="tool-group-description">{{ collection.description }}</p>{% endif %}
					<ul class="tool-cards">
						{% for item in collection.entries %}
							{% set target = entries.get(item.uri) if item.uri|default else None %}
							{# A uri with no entry is scheduled for later; see release.py. #}
							{% if target %}
								{{ toolCard(target.url, item.title|default(target.short_title|default(target.title)), target.description) }}
							{% endif %}
						{% endfor %}
					</ul>
				</section>
			{% endfor %}

			{% if docs %}
			<section class="tool-group" id="templates">
				<h2 class="tool-group-title">
					<span class="icon-stamp">{% include "_icons/accuracy.svg" %}</span>
					Templates and checklists
				</h2>
				<p class="tool-group-description">Documents to copy, adapt and use.</p>
				<ul class="tool-cards">
					{% for doc in docs %}
						{{ toolCard(doc.url, doc.short_title|default(doc.title), doc.description) }}
					{% endfor %}
				</ul>
			</section>
			{% endif %}

			<section class="tool-group" id="maps-and-live-pages">
				<h2 class="tool-group-title">
					<span class="icon-stamp">{% include "_icons/exploring.svg" %}</span>
					Maps, data and live pages
				</h2>
				<p class="tool-group-description">Things to explore rather than calculate.</p>
				<ul class="tool-cards">
					{% for page in live_pages %}
						{{ toolCard(SITE_URL ~ page.url, page.title, page.text) }}
					{% endfor %}
				</ul>
			</section>
		</article>
	</main>
{% endblock %}
