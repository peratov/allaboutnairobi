{# The tools no collection lists, and the documents. #}
{% set unlisted = ['tools/mmf-comparer.md', 'tools/neighbourhood-comparer.md', 'tools/paperwork-planner.md', 'tools/phrasebook.md'] %}
{% set docs = get_entries('docs', sort_by='title') %}

{#
	The interactive pages that are not tools. They are standalone templates, so
	no collection lists them. Counts come from the same data the pages draw.
	Nairobi Pulse and lost and found are listed before they open, saying so.
#}
{% set live_pages = [
	{'url': '/map', 'title': 'Map of Nairobi', 'icon': 'exploring', 'kind': 'Map',
	 'text': 'All ' ~ MAP.constituencies|length ~ ' constituencies and ' ~ MAP.landmarks|length ~ ' landmarks, shaded by population, wealth and rent.'},
	{'url': '/flights', 'title': 'Nonstop flights from Nairobi', 'icon': 'transport', 'kind': 'Map',
	 'text': 'All ' ~ FLIGHTS.destinations|length ~ ' destinations from JKIA, with the airlines that fly each route.'},
	{'url': '/data', 'title': 'Nairobi and Kenya in numbers', 'icon': 'accuracy', 'kind': 'Data',
	 'text': INDICATORS.series|length ~ ' series over sixty years - population, the economy and daily life - Nairobi and Kenya kept apart.'},
	{'url': '/afcon', 'title': 'AFCON 2027 in Nairobi', 'icon': 'football', 'kind': 'Live',
	 'text': 'A live countdown, the three stadiums, and key dates you can add to your calendar.'},
	{'url': '/radio', 'title': 'Nairobi radio, live', 'icon': 'culture', 'kind': 'Live',
	 'text': RADIO.stations|selectattr('stream')|list|length ~ ' Nairobi stations in your browser, with their frequencies.'},
	{'url': '/events', 'title': 'Events in Nairobi', 'icon': 'culture', 'kind': 'Calendar',
	 'text': 'Festivals, matches, public holidays and the fixtures that come round every year.'},
	{'url': '/seasons', 'title': "What's in season", 'icon': 'seasons', 'kind': 'Calendar',
	 'text': AGRICULTURE['items']|length ~ ' foods month by month, from mangoes to omena, and where each is grown.'},
	{'url': '/pulse', 'title': 'Nairobi Pulse', 'icon': 'exploring', 'kind': 'Live' if PULSE_LIVE else 'Opening soon',
	 'text': 'Vote on questions about the city, and see how each of the ' ~ MAP.constituencies|length ~ ' constituencies answers.'},
	{'url': '/lost-and-found', 'title': 'Lost and found', 'icon': 'help', 'kind': 'Live' if LOSTFOUND_LIVE else 'Opening soon',
	 'text': 'List something you lost or found in Nairobi, free. Your number is never shown.'},
] %}

{# Every tool and document, once. Within a group, in the order of tool_meta. #}
{% set ns = namespace(items=[], seen=[]) %}
{% set uris = [] %}
{% for collection in collections %}{% for item in collection.entries %}{% if item.uri|default %}{% set _ = uris.append(item.uri) %}{% endif %}{% endfor %}{% endfor %}
{% for uri in unlisted %}{% set _ = uris.append(uri) %}{% endfor %}
{% for doc in docs %}{% set _ = uris.append(doc.uri|default('docs/' ~ doc.url.split('/')[-1] ~ '.md')) %}{% endfor %}
{% for uri in uris %}
	{% set target = entries.get(uri) %}
	{# A uri with no entry is scheduled for later; see release.py. #}
	{% if target and uri not in ns.seen %}
		{% set meta = tool_meta.get(uri, ('more', 'tools', 'Tool', target.description)) %}
		{% set ns.seen = ns.seen + [uri] %}
		{% set ns.items = ns.items + [{
			'rank': (tool_meta|list).index(uri) if uri in tool_meta else 999,
			'group': meta[0], 'icon': meta[1], 'kind': meta[2], 'text': meta[3],
			'url': target.url, 'title': target.short_title|default(target.title),
			'terms': [target.short_title|default(target.title), target.title, meta[3], target.description|default('')]|join(' ')|lower,
		}] %}
	{% endif %}
{% endfor %}
{% if ns.items|selectattr('group', 'equalto', 'more')|list %}
	{% set tool_groups = tool_groups + [('more', 'More tools', 'tools', 'Everything else that works things out for you.')] %}
{% endif %}
{% set doc_count = ns.items|selectattr('group', 'equalto', 'docs')|list|length %}

{% macro toolCard(url, title, text, icon, kind, terms) %}
	<li data-tix-item data-terms="{{ terms }}">
		<a class="tix-card" href="{{ url }}">
			<span class="icon-stamp tix-icon">{% include "_icons/" ~ icon ~ ".svg" %}</span>
			<span class="tix-words">
				<span class="tix-kind tix-kind-{{ kind|lower|replace(' ', '-') }}">{{ kind }}</span>
				<span class="tix-title">{{ title }}</span>
				<span class="tix-text">{{ text }}</span>
			</span>
		</a>
	</li>
{% endmacro %}

{% block main %}
	<main id="main" class="wide-column" aria-label="Main page">
		<article class="section tix" data-tool-index>
			<header class="tix-hero">
				<div class="section-heading">
					<span class="icon-stamp">{% include "_icons/tools.svg" %}</span>
					<h1>Tools and templates</h1>
				</div>
				<p class="page-intro">
					Calculators that use the same figures as the guides, planners that put
					the steps in order, and templates you can copy. Nothing you type is
					sent anywhere &mdash; every calculation happens on your own device.
				</p>
				<p class="tix-stats">
					<span><strong>{{ ns.items|length - doc_count }}</strong> tools</span>
					<span><strong>{{ doc_count }}</strong> plans and templates</span>
					<span><strong>{{ live_pages|length }}</strong> maps and live pages</span>
				</p>

				<div class="tix-find" data-tix-find hidden>
					<label class="visually-hidden" for="tix-filter">Find a tool</label>
					<span class="tix-find-icon" aria-hidden="true">{% include "_icons/search.svg" %}</span>
					<input type="search" id="tix-filter" data-tix-filter placeholder="Find a tool: tax, rent, car, Swahili..." autocomplete="off" data-clarity-mask="true">
				</div>

				<nav class="tix-jump" aria-label="Groups">
					{% for id, title, icon, blurb in tool_groups %}
						{% set n = ns.items|selectattr('group', 'equalto', id)|list|length %}
						{% if n %}<a href="#{{ id }}">{{ title }} <span>{{ n }}</span></a>{% endif %}
					{% endfor %}
					<a href="#maps-and-live-pages">Maps and live pages <span>{{ live_pages|length }}</span></a>
				</nav>
			</header>

			{% for id, title, icon, blurb in tool_groups %}
				{% set items = ns.items|selectattr('group', 'equalto', id)|sort(attribute='rank')|list %}
				{% if items %}
				<section class="tix-group" id="{{ id }}" data-tix-group>
					<h2 class="tix-group-title">
						<span class="icon-stamp">{% include "_icons/" ~ icon ~ ".svg" %}</span>
						<span>{{ title }}</span>
					</h2>
					<p class="tix-group-blurb">{{ blurb }}</p>
					<ul class="tix-cards">
						{% for t in items %}{{ toolCard(t.url, t.title, t.text, t.icon, t.kind, t.terms) }}{% endfor %}
					</ul>
				</section>
				{% endif %}
			{% endfor %}

			<section class="tix-group" id="maps-and-live-pages" data-tix-group>
				<h2 class="tix-group-title">
					<span class="icon-stamp">{% include "_icons/exploring.svg" %}</span>
					<span>Maps, data and live pages</span>
				</h2>
				<p class="tix-group-blurb">Things to explore rather than work out.</p>
				<ul class="tix-cards">
					{% for page in live_pages %}
						{{ toolCard(SITE_URL ~ page.url, page.title, page.text, page.icon, page.kind, [page.title, page.text, page.kind]|join(' ')|lower) }}
					{% endfor %}
				</ul>
			</section>

			<p class="tix-empty" data-tix-empty hidden>
				No tool matches that. <a data-tix-search href="{{ SITE_URL }}/search">Search the guides &#10142;</a>
			</p>
		</article>
	</main>
{% endblock %}
