{% extends "_layout.html" %}
{% set canonical_path = "/tools" %}
{% set metatitle = "Calculators and templates" %}
{% set metadescription = "Free Kenyan calculators - take-home pay, household staff, move-in costs, loans, stamp duty and VAT - plus tenancy, receipt and resignation templates." %}
{% set docs = get_entries('docs', sort_by='title') %}
{% set calculators = (get_entries('collections')|selectattr('id', 'equalto', 'calculators')|first).entries %}

{% block main %}
	<main id="main" class="wide-column" aria-label="Main page">
		<article class="section">
			<div class="section-heading">
				<span class="icon-stamp">{% include "_icons/tools.svg" %}</span>
				<h1>Calculators and templates</h1>
			</div>
			<p class="page-intro">
				Calculators that use the same figures as the guides, and documents you
				can copy and adapt. Nothing you type is sent anywhere &mdash; every sum
				happens on your own device.
			</p>

			<h2 id="calculators">Calculators</h2>
			<ul class="card-grid">
				{% for item in calculators %}
					{% set tool = entries[item.uri] %}
					<li>
						<a class="card" href="{{ tool.url }}">
							<span class="icon-stamp">{% include "_icons/money.svg" %}</span>
							<h3>{{ tool.short_title|default(tool.title) }}</h3>
							<p>{{ tool.description }}</p>
						</a>
					</li>
				{% endfor %}
			</ul>

			<h2 id="templates">Templates and checklists</h2>
			<ul class="card-grid">
				{% for doc in docs %}
					<li>
						<a class="card" href="{{ doc.url }}">
							<span class="icon-stamp">{% include "_icons/accuracy.svg" %}</span>
							<h3>{{ doc.short_title|default(doc.title) }}</h3>
							<p>{{ doc.description }}</p>
						</a>
					</li>
				{% endfor %}
			</ul>

			<p>
				&mdash; <a href="{{ SITE_URL }}/map">The interactive map of Nairobi &#8658;</a>
			</p>
		</article>
	</main>
{% endblock %}
