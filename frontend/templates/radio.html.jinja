{% extends "_layout.html" %}
{% set canonical_path = "/radio" %}
{% set stations = RADIO.stations %}
{% set fm = stations|selectattr('frequency')|list %}
{% set metatitle = "Nairobi radio live: Capital FM, Kameme, Radio 47 and more" %}
{% set metadescription = "Listen live to " ~ stations|length ~ " Nairobi radio stations - Capital FM, Kameme FM, Radio 47 and more - free, in your browser, with their frequencies." %}

{% block postHead %}
	{{ super() }}
	<script type="application/ld+json">
	{
		"@context": "https://schema.org",
		"@type": "ItemList",
		"name": "Radio stations in Nairobi you can listen to live",
		"numberOfItems": {{ fm|length }},
		"itemListElement": [
			{% for s in fm %}{
				"@type": "ListItem",
				"position": {{ loop.index }},
				"item": {
					"@type": "RadioStation",
					"name": {{ s.name|tojson }},
					"areaServed": { "@type": "City", "name": "Nairobi" },
					"broadcastFrequency": {
						"@type": "BroadcastFrequencySpecification",
						"broadcastFrequencyValue": {{ s.frequency }},
						"broadcastSignalModulation": "FM"
					}
				}
			}{% if not loop.last %},{% endif %}
			{% endfor %}
		]
	}
	</script>
{% endblock %}

{% block main %}
	<main id="main" aria-label="Main page">
		<article class="section">
			<div class="section-heading">
				<span class="icon-stamp">{% include "_icons/culture.svg" %}</span>
				<h1>Nairobi radio, live</h1>
			</div>

			<p class="page-intro">
				{{ stations|length }} stations broadcasting in Nairobi, playable right
				here. Press a station to listen; press it again to stop. Every stream
				was tested on {{ RADIO.meta.checked_on }}.
			</p>

			<radio-player>
				<ul class="radio-list">
					{% for s in stations %}
					{% set group = 'Online only' if not s.frequency else (s.language or 'Other') %}
					<li class="radio-station"
						data-id="{{ s.id }}"
						data-name="{{ s.name }}"
						data-freq="{{ s.frequency or '' }}"
						data-group="{{ group }}"
						data-stream="{{ s.stream }}">
						<div class="radio-station-body">
							<h2 class="radio-station-name">
								{{ s.name }}{% if s.frequency %}<span class="radio-station-freq">{{ s.frequency }} FM</span>{% else %}<span class="radio-station-freq">online</span>{% endif %}
							</h2>
							<p class="radio-station-about">
								{{ s.about }}{% if s.language %} &middot; {{ s.language }}{% endif %}{% if s.owner %} &middot; {{ s.owner }}{% endif %}{% if s.homepage %} &middot; <a href="{{ s.homepage }}" rel="noopener">website</a>{% endif %}
							</p>
						</div>
					</li>
					{% endfor %}
				</ul>
			</radio-player>

			<noscript>
				<p class="tool-note">
					Playing a station needs JavaScript. Every station is listed above
					with its frequency and a link to its own site, which carries its own
					player.
				</p>
			</noscript>
		</article>

		<article class="section radio-extra">
			<h2 id="about-these-streams">About these streams</h2>

			<p>
				<strong>Nothing is loaded until you press play.</strong> The audio comes
				straight from each station's own streaming server, not through this
				site, so that server sees your IP address, the way any website you visit
				does. Until you press play it has not been contacted at all. Stopping a
				station closes the connection, so a paused stream is not quietly using
				your data. What else this site does and does not share is in the
				<a href="{{ SITE_URL }}/terms">terms</a>.
			</p>

			{% set kbps = RADIO.meta.typical_kbps %}
			<p>
				<strong>Streaming uses data.</strong> These streams mostly run at
				{{ kbps }} kbps, which is about {{ (kbps * 3600 / 8 / 1000)|round|int }} MB an
				hour. An hour a day comes to roughly {{ '%.1f'|format(kbps * 3600 * 30 / 8 / 1000 / 1000) }} GB
				a month: worth knowing on a mobile bundle, nothing on home fibre.
			</p>

			<p>
				<strong>Keep listening while you read.</strong> Press <em>Pop out</em>
				in the player and the station keeps playing in a small window of its
				own while you use the rest of the site. On a phone, the controls appear
				on your lock screen.
			</p>

			<h2 id="where-this-comes-from">Where this comes from</h2>
			<p>
				Radio stations in Kenya are authorised and regulated by the Communications Authority of Kenya (CAK).
				A station is listed here only if its stream answered with audio when the
				list was last tested, on {{ RADIO.meta.checked_on }}. Streams move; if one
				stops working, the station's own website usually has its current player.
			</p>
			<p>
				&mdash; <a href="{{ SITE_URL }}/guides">Guides to living in Nairobi &#8658;</a>
			</p>
		</article>
	</main>

	<script type="module">
		import '{{ SITE_URL }}/js/components/radio-player.mjs';
	</script>
{% endblock %}
