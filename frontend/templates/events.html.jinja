{% extends "_layout.html" %}
{% set page_styles = ['events'] %}
{% set canonical_path = "/events" %}
{% set metatitle = "Events in Nairobi" %}
{% set metadescription = "What is on in Nairobi - festivals, music, public holidays and the annual fixtures. Past dates drop off by themselves." %}

{% from "_blocks/eventCard.html" import event_card %}

{% block main %}
	<main id="main" class="wide-column" aria-label="Main page">
		<article class="section events-page">
			<div class="section-heading">
				<span class="icon-stamp">{% include "_icons/culture.svg" %}</span>
				<h1>Events in Nairobi</h1>
			</div>

			<p class="page-intro">
				What is coming up, soonest first. A date that has passed disappears
				from this page by itself &mdash; including if you are reading a copy
				your browser cached weeks ago.
			</p>

			{# Organisers can send their own; a person checks each before it is here. #}
			<aside class="event-submit-banner" aria-label="List your event">
				<span class="event-submit-banner-icon" aria-hidden="true">
					<svg viewBox="0 0 24 24"><rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M3.5 10h17M8 3v4M16 3v4M12 12.5v5M9.5 15h5"/></svg>
				</span>
				<p>
					<strong>Running something in Nairobi?</strong>
					<span>List it here, free. A person checks every event, usually within a day or two.</span>
				</p>
				<a class="event-submit-button" href="{{ SITE_URL }}/events/submit">List your event</a>
			</aside>

			{#
				The next real event, large. Filled by events-filter.mjs from the
				first card still to come - against the reader's clock, so it is
				never one that has passed - and left out without scripting, when
				the list below says the same thing.
			#}
			<section class="event-next" data-event-next hidden aria-labelledby="event-next-label">
				<p class="event-next-label" id="event-next-label">Next up</p>
				<ul class="event-list" data-event-next-list></ul>
			</section>

			{% if EVENTS.categories %}
				<div class="event-filters" data-event-filters hidden>
					<span class="event-filters-label visually-hidden" id="event-filter-label">Show</span>
					<div class="event-filter-chips" role="group" aria-labelledby="event-filter-label">
						<button type="button" class="event-chip is-on" data-filter="all" aria-pressed="true">
							Everything
						</button>
						{% for category in EVENTS.categories %}
							<button type="button" class="event-chip" data-filter="{{ category.slug }}" aria-pressed="false">
								{{ category.label }}
							</button>
						{% endfor %}
					</div>
				</div>
			{% endif %}

			<p class="event-empty" data-event-empty hidden>
				Nothing in that category is coming up. Try another.
			</p>
			{# Shown when a category has no dated events but some yearly ones. #}
			<p class="event-empty" data-event-annual-only hidden>
				Nothing in that category has a date yet.
				<a href="#every-year" data-event-annual-link></a>
			</p>

			{% if EVENTS.months %}
				{% for month in EVENTS.months %}
					<section class="event-month-group" data-event-month>
						<h2 class="event-month-heading">{{ month.label }}</h2>
						<ul class="event-list">
							{% for event in month.events %}{{ event_card(event) }}{% endfor %}
						</ul>
					</section>
				{% endfor %}
			{% else %}
				<p class="tool-note">
					Nothing dated is listed at the moment. The annual fixtures below
					still stand.
				</p>
			{% endif %}
		</article>

		{% if EVENTS.annual %}
			<article class="section events-annual">
				<h2 id="every-year">Every year in Nairobi</h2>
				<p class="page-intro">
					Fixtures that come round annually and whose dates for the next
					edition have not been announced. There is no date on these on
					purpose: a guessed date that sends you across town is worse than
					no date at all.
				</p>
				<ul class="event-list">
					{% for event in EVENTS.annual %}{{ event_card(event) }}{% endfor %}
				</ul>
			</article>
		{% endif %}

		<article class="section">
			<h2 id="how-this-works">How this page is kept</h2>
			<p>
				Kenya's public holidays are <strong>computed</strong>, not typed. They
				are generated from the Public Holidays Act calendar every time the site
				is built, so they roll forward on their own.
			</p>
			<p>
				Everything else is <strong>checked by hand</strong>. There is no public
				events API with comprehensive Nairobi coverage, so anything claiming to
				pull events automatically is either scraping somebody or showing you nothing.
				Each listing here carries where it came from and when it was last checked.
			</p>
			<p>
				<strong>Know something that should be here?</strong>
				&mdash; <a href="mailto:{{ CONTACT_EMAIL }}?subject=Event%20for%20the%20Nairobi%20events%20page">Send it to us</a>,
				with a date and a link.
			</p>
			<p class="tool-note">
				Always check the organiser's own page before travelling. Dates in Nairobi
				move, and the announcement is often on Instagram and social media.
			</p>

			<p>
				&mdash; <a href="{{ SITE_URL }}/guides/public-holidays-in-kenya">Public holidays in Kenya &#8658;</a><br>
				&mdash; <a href="{{ SITE_URL }}/guides/things-to-do-in-nairobi">Things to do in Nairobi &#8658;</a><br>
				&mdash; <a href="{{ SITE_URL }}/guides/day-trips-from-nairobi">Day trips from Nairobi &#8658;</a>
			</p>
		</article>
	</main>

{% endblock %}

{% block postFooter %}
	{% queueJs %}
		import '/js/components/events-filter.mjs';
	{% endqueueJs %}
	{{ super() }}
{% endblock %}
