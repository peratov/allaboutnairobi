{% extends "_layout.html" %}
{#
	Guides, tools and documents - the last two extend this template. Every one
	carries the rating prompt; the calculator styles come only with a body that
	mounts a calculator, which is about one guide in seven.
#}
{% set page_styles = ['rating'] %}
{% if '% tool "' in entry.body %}{% set page_styles = page_styles + ['tools'] %}{% endif %}
{% if (entry.tool|default('')|string).startswith('afcon-') %}{% set page_styles = page_styles + ['afcon'] %}{% endif %}
{% if 'neighbourhoodComparer' in entry.body %}{% set page_styles = page_styles + ['compare'] %}{% endif %}
{% if '_blocks/phrasebook.html' in entry.body %}{% set page_styles = page_styles + ['phrasebook'] %}{% endif %}
{% if NEWSLETTER_LIVE %}{% set page_styles = page_styles + ['subscribe'] %}{% endif %}
{% set metatitle = entry.title %}
{% set metadescription = entry.description %}

{% block postHead %}
	{{ super() }}
	<link rel="index" href="{{ SITE_URL }}/guides">
{% endblock %}

{% block main %}
	<main id="main" aria-label="Main page">
		<article class="section">
			<h1>{{ entry.title }}</h1>
			{% include "_blocks/postMeta.html" %}

			<div class="article-body">
				{{ entry.body|render|safe }}
			</div>

			{% include "_blocks/verifiedNotice.html" %}
			{% include "_blocks/guideRating.html" %}

			{#
				With the site's own list running, every guide ends with a way to
				hear when the rules move - the reason most people would want the
				newsletter at all. The page it was on is kept with the sign-up.
			#}
			{% if NEWSLETTER_LIVE %}
				{% with compact=true %}{% include "_blocks/subscribeForm.html" %}{% endwith %}
			{% endif %}
		</article>

		{% if entry.collections|default %}
			<aside id="related" class="section no-print" aria-label="Related guides" data-nosnippet>
				<h2>{% include "_icons/related.svg" %} Related guides</h2>
				{% with collections=entry.collections, currentEntry=entry %}
					{% include "_blocks/collections.html" %}
				{% endwith %}
			</aside>
		{% endif %}

		{% with entry=entry, showRelatedEntriesLink=entry.collections|default(false) %}
			{% include "_blocks/sidebar.html" %}
		{% endwith %}
	</main>
{% endblock %}

{% block postFooter %}
	{{ super() }}
	<script type="application/ld+json">
	{
		"@context": "https://schema.org",
		"@type": "Article",
		"headline": {{ entry.title|tojson }},
		"description": {{ entry.description|tojson }},
		"inLanguage": "en-KE",
		"url": "{{ canonical_url }}",
		{% if entry.date_created|default %}"datePublished": "{{ entry.date_created.strftime('%Y-%m-%d') }}",{% endif %}
		{% set _modified = entry.date_updated|default(entry.date_created|default(none)) %}
		{% if _modified %}"dateModified": "{{ _modified.strftime('%Y-%m-%d') }}",{% endif %}
		"author": { "@id": "{{ CANONICAL_ORIGIN }}/#organization" },
		"publisher": { "@id": "{{ CANONICAL_ORIGIN }}/#organization" },
		"image": "{{ CANONICAL_ORIGIN }}/staticimages/og-image.png",
		"isPartOf": { "@id": "{{ CANONICAL_ORIGIN }}/#site" },
		"mainEntityOfPage": { "@type": "WebPage", "@id": "{{ canonical_url }}" },
		{#- Named entities, so search engines tie every page to the city and the
		    country rather than to the words alone. -#}
		"about": {
			"@type": "City",
			"name": "Nairobi",
			"sameAs": "https://www.wikidata.org/wiki/Q3870",
			"containedInPlace": { "@type": "Country", "name": "Kenya", "sameAs": "https://www.wikidata.org/wiki/Q114" }
		}
	}
	</script>
	{% if entry.tool|default or 'neighbourhoodComparer' in entry.body %}
	{#- A tool is also a free web application. -#}
	<script type="application/ld+json">
	{
		"@context": "https://schema.org",
		"@type": "WebApplication",
		"name": {{ entry.short_title|default(entry.title)|tojson }},
		"description": {{ entry.description|tojson }},
		"url": "{{ canonical_url }}",
		"applicationCategory": "{{ 'FinanceApplication' if (entry.tool|default('')|string) not in ('', 'afcon-matchday-planner') else 'UtilitiesApplication' }}",
		"operatingSystem": "Any",
		"browserRequirements": "Requires JavaScript",
		"inLanguage": "en-KE",
		"isAccessibleForFree": true,
		"offers": { "@type": "Offer", "price": "0", "priceCurrency": "KES" },
		"publisher": { "@id": "{{ CANONICAL_ORIGIN }}/#organization" },
		"areaServed": { "@type": "Country", "name": "Kenya" }
	}
	</script>
	{% endif %}
{% endblock %}
