{% extends "_layout.html" %}
{% set canonical_path = "/guides" %}
{% set metatitle = "All guides" %}
{% set metadescription = "Every All About Accra guide, grouped by subject and ordered the way you need them: arriving, paperwork, housing, money, work, business and daily life." %}
{% set collections = get_entries('collections')|selectattr('type', 'equalto', 'guides')|list %}

{% block main %}
	<main id="main" class="wide-column" aria-label="Main page">
		<article class="section">
			<div class="section-heading">
				<span class="adinkra-stamp">{% include "_icons/guides.svg" %}</span>
				<h1>All guides</h1>
			</div>
			<p class="page-intro">
				{{ get_entries('guides')|length }} guides to living in Accra, in the order
				you are likely to need them &mdash; arrive, get legal, get housed, sort
				the money, then earn.
			</p>

			{#
				A jump list, because sixteen sections in one column is a page you
				scroll rather than read. Real links to real anchors, so it works
				with no JavaScript and a crawler sees the structure too.
			#}
			<nav class="guide-jump" aria-label="Jump to a subject">
				<ul>
					{% for collection in collections %}
						<li>
							<a href="#{{ collection.id }}">
								{{ collection.short_title|default(collection.title) }}
								<span class="guide-jump-count">{{ collection.entry_count }}</span>
							</a>
						</li>
					{% endfor %}
				</ul>
			</nav>
		</article>

		{#
			Each subject is its own card rather than one long list, and they sit
			two-up on a wide screen. The heading carries the anchor the jump list
			points at.
		#}
		<div class="guide-grid">
			{% for collection in collections %}
				<article class="guide-group" id="{{ collection.id }}">
					<h2 class="guide-group-title">
						<span class="adinkra-stamp">{% include "_icons/" + collection.symbol + ".svg" %}</span>
						<a href="{{ collection.url }}">{{ collection.title }}</a>
						<span class="guide-group-count">{{ collection.entry_count }} guides</span>
					</h2>
					{% if collection.description|default %}
						<p class="guide-group-description">{{ collection.description }}</p>
					{% endif %}
					{% with collections=[collection], bare=true %}
						{% include "_blocks/collections.html" %}
					{% endwith %}
				</article>
			{% endfor %}
		</div>
	</main>
{% endblock %}
