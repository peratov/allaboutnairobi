{% extends "_layout.html" %}
{% set canonical_path = "/glossary" %}
{% set metatitle = "Glossary of Ghanaian terms" %}
{% set metadescription = "Ghanaian acronyms, bureaucracy and everyday Twi, Ga and pidgin explained in plain English - from SSNIT and GhanaPostGPS to chale and chamber and hall." %}

{% set terms = get_entries('glossary') %}
{% set groups = glossary_groups(terms) %}

{% block main %}
	<main id="main" class="wide-column" aria-label="Main page">
		<article class="section">
			<div class="section-heading">
				<span class="adinkra-stamp">{% include "_icons/glossary.svg" %}</span>
				<h1>Glossary</h1>
			</div>
			<p class="page-intro">
				{{ terms|length }} words you will hear in Accra and nobody will stop to
				explain: government acronyms, housing vocabulary, and the Twi, Ga and
				pidgin that carry most ordinary conversations.
			</p>

			<nav class="glossary-jump" aria-label="Jump to letter">
				{% for letter in groups %}
					<a href="#letter-{{ letter|lower }}">{{ letter }}</a>
				{% endfor %}
			</nav>

			<div class="glossary-index">
				{% for letter, letter_terms in groups.items() %}
					<section class="glossary-group" id="letter-{{ letter|lower }}">
						<h2>{{ letter }}</h2>
						<dl>
							{% for term in letter_terms %}
								<dt>
									<a href="{{ term.url }}">{{ term.local_term }}</a>
									{%- if term.language|default %}<span class="term-language">{{ term.language }}</span>{% endif -%}
								</dt>
								<dd>{{ term.description }}</dd>
							{% endfor %}
						</dl>
					</section>
				{% endfor %}
			</div>
		</article>
	</main>
{% endblock %}
