{% extends "_layout.html" %}

{% set canonical_path = "/" %}
{% set metatitle = SITE_NAME + " - " + SITE_TAGLINE %}
{% set metadescription = SITE_DESCRIPTION %}

{% set guides = get_entries('guides', sort_by='title') %}
{% set glossary = get_entries('glossary') %}
{% set constituencies = MAP.constituencies|default([]) %}
{% set collections = get_entries('collections') %}

{% block main %}
	<main id="main" class="wide-column" aria-label="Main page">
		<section class="hero">
			<div class="hero-inner">
			<div class="hero-text">
			<h1>Everything nobody tells you about living in Nairobi</h1>
			<p>
				Free, independent guides to Kenyan paperwork, housing, money and daily
				life, and an interactive map of the city. Written for anyone making
				Nairobi home &mdash; new arrivals, returnees, and Nairobians who have
				never had to file a KRA return before.
			</p>
			{% include "_blocks/searchForm.html" %}
			</div>

			{% include "_blocks/heroMap.html" %}
			</div>

			<ul class="stat-row">
				<li class="stat">
					<span class="stat-value">{{ guides|length }}</span>
					<span class="stat-label">guides</span>
				</li>
				<li class="stat">
					<span class="stat-value">{{ glossary|length }}</span>
					<span class="stat-label">terms explained</span>
				</li>
				<li class="stat">
					<span class="stat-value">{{ constituencies|length }}</span>
					<span class="stat-label">constituencies mapped</span>
				</li>
				<li class="stat">
					<span class="stat-value">KES 0</span>
					<span class="stat-label">to use, always</span>
				</li>
			</ul>
		</section>

		<article class="section">
			<p class="radio-promo">
				<a href="{{ SITE_URL }}/radio"><strong>Listen live</strong> to
				{{ or_list(RADIO.stations|map(attribute='name')|list)|replace(' or ', ' and ') }} &#8658;</a>
			</p>

			<h2 id="start-here">Start here</h2>
			<p class="page-intro">
				The things that block everything else. Until these are done, you cannot
				open a bank account, sign a lease or get paid properly.
			</p>

			<ul class="card-grid">
				<li>
					<a class="card" href="{{ SITE_URL }}/guides/moving-to-nairobi">
						<span class="icon-stamp">{% include "_icons/moving.svg" %}</span>
						<h3>Arrive legally</h3>
						<p>The eTA, work permits, and what to sort in your first fortnight.</p>
					</a>
				</li>
				<li>
					<a class="card" href="{{ SITE_URL }}/guides/ecitizen-kra-pin-and-ids">
						<span class="icon-stamp">{% include "_icons/identity.svg" %}</span>
						<h3>Get a KRA PIN</h3>
						<p>eCitizen, your PIN and your ID: the numbers everything asks for.</p>
					</a>
				</li>
				<li>
					<a class="card" href="{{ SITE_URL }}/guides/neighbourhoods-of-nairobi">
						<span class="icon-stamp">{% include "_icons/housing.svg" %}</span>
						<h3>Choose where to live</h3>
						<p>Pick the neighbourhood by your commute, then the flat. With the map.</p>
					</a>
				</li>
				<li>
					<a class="card" href="{{ SITE_URL }}/guides/mpesa-and-mobile-money">
						<span class="icon-stamp">{% include "_icons/money.svg" %}</span>
						<h3>Set up M-Pesa</h3>
						<p>Rent, bills, shops and matatus all run on it. And the scams to avoid.</p>
					</a>
				</li>
				<li>
					<a class="card" href="{{ SITE_URL }}/guides/getting-around-nairobi">
						<span class="icon-stamp">{% include "_icons/transport.svg" %}</span>
						<h3>Learn to move</h3>
						<p>Matatus, ride-hailing, boda bodas, the Expressway and the SGR.</p>
					</a>
				</li>
				<li>
					<a class="card" href="{{ SITE_URL }}/guides/healthcare-in-nairobi">
						<span class="icon-stamp">{% include "_icons/health.svg" %}</span>
						<h3>Get health cover</h3>
						<p>SHA and SHIF, private insurance, hospitals and emergencies.</p>
					</a>
				</li>
				<li>
					<a class="card" href="{{ SITE_URL }}/guides/paye-and-taxes">
						<span class="icon-stamp">{% include "_icons/accuracy.svg" %}</span>
						<h3>Check your payslip</h3>
						<p>PAYE, NSSF, SHIF and the Housing Levy, with a worked example.</p>
					</a>
				</li>
				<li>
					<a class="card" href="{{ SITE_URL }}/guides/things-to-do-in-nairobi">
						<span class="icon-stamp">{% include "_icons/exploring.svg" %}</span>
						<h3>Explore the city</h3>
						<p>Lions by the skyline, forests, museums, and trips out of town.</p>
					</a>
				</li>
			</ul>
		</article>

		<article class="section">
			<h2 id="numbers">The numbers, today</h2>
			<p class="page-intro">
				Every figure on this site comes from one dated file, so a guide can never
				quietly go stale.
				<a href="{{ SITE_URL }}/about#how-this-site-stays-accurate">How that works &#10142;</a>
			</p>

			<div class="table-wrapper">
				<table>
					<thead>
						<tr>
							<th scope="col">What</th>
							<th scope="col" class="numeric">How much</th>
							<th scope="col">Where it bites</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<th scope="row">Minimum wage, Nairobi</th>
							<td class="numeric">KES {{ NAIROBI_MIN_WAGE_GENERAL_LABOURER|shillings }}</td>
							<td>A month, for a general labourer, from May 2026</td>
						</tr>
						<tr>
							<th scope="row">Lowest PAYE rate</th>
							<td class="numeric">{{ PAYE_RATE_1|percent }}%</td>
							<td>On the first KES {{ PAYE_BAND_1_LIMIT|shillings }} a month, less KES {{ PERSONAL_RELIEF_MONTHLY|shillings }} relief</td>
						</tr>
						<tr>
							<th scope="row">NSSF off your payslip</th>
							<td class="numeric">{{ NSSF_RATE|percent }}%</td>
							<td>Up to KES {{ NSSF_MAX_EMPLOYEE|shillings }} a month; your employer matches it</td>
						</tr>
						<tr>
							<th scope="row">SHIF and Housing Levy</th>
							<td class="numeric">{{ SHIF_RATE|percent }}% + {{ HOUSING_LEVY_RATE|percent }}%</td>
							<td>Of gross pay, before PAYE is worked out</td>
						</tr>
						<tr>
							<th scope="row">Largest M-Pesa payment</th>
							<td class="numeric">KES {{ MPESA_MAX_TRANSACTION|shillings }}</td>
							<td>Anything bigger goes through a bank</td>
						</tr>
						<tr>
							<th scope="row">Nairobi's population</th>
							<td class="numeric">{{ MAP.population|count }}</td>
							<td>At the 2019 census, across {{ constituencies|length }} constituencies</td>
						</tr>
					</tbody>
				</table>
			</div>
		</article>

		<article class="section">
			<h2 id="browse">Browse everything</h2>
			{% with collections=collections %}
				{% include "_blocks/collections.html" %}
			{% endwith %}
		</article>
	</main>
{% endblock %}
