"""
All About Nairobi - Ursus configuration.

Ursus turns `content/` (Markdown + YAML) plus `templates/` (Jinja2) into a
static site in `output/`. This file is where the Ghanaian arithmetic lives:
constants are loaded from content/constants.yaml, and everything derivable
from them is derived here exactly once, so that no guide ever hardcodes a
PAYE band or a SSNIT rate.
"""

from datetime import date, datetime
from decimal import ROUND_HALF_UP, Decimal
from pathlib import Path
from zoneinfo import ZoneInfo
import json
import logging
import os

import yaml
from markupsafe import Markup
from ursus.config import config

from extensions.functions import (
    build_wikilinks_url,
    dashboard_constants,
    get_public_holidays,
    glossary_groups,
    load_constants_from_file,
    or_list,
    patched_slugify,
    slugify_plain,
    random_id,
    to_shillings,
    to_compact,
    to_count,
    to_number,
    to_percent,
    to_usd,
)


def env_str(name: str, default: str = "") -> str:
    """
    Read an environment variable, treating an empty value as unset.

    Hosting dashboards happily store a variable with no value, and
    `os.environ.get(name, default)` then returns "" rather than the default -
    so CONTACT_EMAIL silently becomes blank, and int("") raises a ValueError
    that names neither the variable nor the file it came from. An unset
    variable and an empty one mean the same thing here.
    """
    return (os.environ.get(name) or "").strip() or default


def env_flag(name: str, default: bool) -> bool:
    """
    Read a boolean environment variable.

    Accepts 1/0, true/false, yes/no and on/off in any case. Anything else is a
    configuration mistake worth failing loudly for, rather than quietly
    treating as false.
    """
    raw = env_str(name)
    if not raw:
        return default

    truthy = {"1", "true", "yes", "on"}
    falsy = {"0", "false", "no", "off"}

    if raw.lower() in truthy:
        return True
    if raw.lower() in falsy:
        return False

    raise ValueError(
        f"{name}={raw!r} is not a boolean. Use 1/0, true/false, yes/no or on/off."
    )


config.content_path = Path(__file__).parent / "content"
config.templates_path = Path(__file__).parent / "templates"

ctx: dict = {}
ctx.update(load_constants_from_file(config.content_path / "constants.yaml"))

# The Adinkra symbols used as the site's icons, and what each one means.
# Generated by scripts/build_icons.py alongside the SVGs themselves, so the
# legend on the About page cannot drift from the symbols it describes.
ctx["ADINKRA"] = yaml.safe_load(
    (config.content_path / "adinkra.yaml").read_text(encoding="utf-8")
)

# The map's data minus the geometry, generated by scripts/build_map_data.py.
# /map renders every district, constituency and landmark from this as text.
# That is what a reader with JavaScript off gets, and what a crawler indexes -
# a page whose content only exists after a fetch() is a page Google reads as
# empty, and this one is 29 assemblies and 34 constituencies of real content.
ctx["MAP"] = yaml.safe_load(
    (config.content_path / "geo" / "map-summary.yaml").read_text(encoding="utf-8")
)

# How much of Greater Nairobi works informally, averaged across the 29 district
# assemblies. Derived here rather than in a guide, because it is arithmetic on
# the census and the rule is that a guide never does arithmetic.
#
# An unweighted mean of the district percentages, which is the honest reading:
# weighting by population would answer a different question ("what share of
# workers", which the census reports directly) and this one is "what does a
# typical district look like".
_informal = [d["informalPct"] for d in ctx["MAP"]["districts"] if d.get("informalPct")]
ctx["AVERAGE_DISTRICT_INFORMAL_PCT"] = round(sum(_informal) / len(_informal)) if _informal else 0
ctx["HIGHEST_DISTRICT_INFORMAL_PCT"] = round(max(_informal)) if _informal else 0

# TODO: Add Kenya-specific derived values here
# (Accra poultry calculations removed - not relevant to Nairobi)

# The Kotoka route network, without geometry, so /flights can list every
# destination as HTML. Same reasoning as MAP above: a page whose content only
# exists after a fetch() is a page Google reads as empty, and this one is 38
# destinations and 28 airlines of real content.
ctx["FLIGHTS"] = yaml.safe_load(
    (config.content_path / "geo" / "flights-summary.yaml").read_text(encoding="utf-8")
)

# Every series on /data minus the points themselves - first value, last value,
# source and scope. Same reasoning as MAP and FLIGHTS: the charts only exist
# after a fetch(), so the page renders all 30 series as tables from this, which
# is what a crawler indexes and what a reader with JavaScript off reads.
#
# The `scope` on each row is the load-bearing field. Almost nothing here is
# Nairobi - Ghana publishes no regional GDP series - so the page has to say which
# is which on every single figure, and it takes that from here.
ctx["INDICATORS"] = yaml.safe_load(
    (config.content_path / "geo" / "indicators-summary.yaml").read_text(encoding="utf-8")
)

# The venues behind the night-out planner. Same arrangement as MAP and
# FLIGHTS: the tools page lists every one of them as HTML from this, which is
# what a crawler indexes and what a reader with JavaScript off gets, and
# renderers/nightlife_json.py emits the scoring fields alone for the planner.
#
# Every cost in it is an estimate and the file says so in meta.basis. The
# planner repeats it on screen, because a caveat that lives only in a YAML
# file is a caveat nobody reads.
ctx["NIGHTLIFE"] = yaml.safe_load(
    (config.content_path / "geo" / "nightlife.yaml").read_text(encoding="utf-8")
)

# The stations behind /radio, generated by scripts/build_radio_data.py, which
# checks every frequency against the NCA register and every stream by playing
# audio from it. StaleDataFilesLinter expires it like any other data file, and
# three months after the check rather than a year, because streams move.
ctx["RADIO"] = yaml.safe_load(
    (config.content_path / "geo" / "radio.yaml").read_text(encoding="utf-8")
)
# The generator leaves out a field a station does not have - Oroko Radio has no
# frequency, some stations no stated owner. Templates run under StrictUndefined,
# so fill the optional fields once here rather than guarding every use.
for _station in ctx["RADIO"]["stations"]:
    for _field in ("frequency", "owner", "language", "website", "bitrate"):
        _station.setdefault(_field, None)
_radio_checked = date.fromisoformat(str(ctx["RADIO"]["meta"]["last_verified"]))
ctx["RADIO_CHECKED_ON"] = f"{_radio_checked.day} {_radio_checked:%B %Y}"

# Data use, from the bitrates the streams themselves report, so the figure a
# guide quotes is what the player actually downloads. The median, because one
# 320 kbps music stream should not set the figure for a page of 128s. None
# when no stream reported a bitrate, and the pages then say nothing rather
# than guess.
_radio_rates = sorted(s["bitrate"] for s in ctx["RADIO"]["stations"] if s.get("bitrate"))
if _radio_rates:
    ctx["RADIO_TYPICAL_KBPS"] = _radio_rates[len(_radio_rates) // 2]
    ctx["RADIO_MB_PER_HOUR"] = round(ctx["RADIO_TYPICAL_KBPS"] * 3600 / 8 / 1000)
    ctx["RADIO_GB_PER_MONTH"] = round(ctx["RADIO_MB_PER_HOUR"] * 30 / 1000, 1)
else:
    ctx["RADIO_TYPICAL_KBPS"] = ctx["RADIO_MB_PER_HOUR"] = ctx["RADIO_GB_PER_MONTH"] = None

# Each of those thirty series flattened into named values the guides can
# interpolate - DATA_Nairobi_POPULATION_LAST, DATA_GHANA_INFLATION_LAST and so
# on - because the one rule is that no number is ever typed into a guide, and
# a guide about the data is still a guide.
#
# DASHBOARD_SERIES in extensions/functions.py is the single source of truth for
# those names: this builds the values from it, UndefinedConstantsLinter builds
# its allowlist from it, and dashboard_constants() raises if the map and the
# data have drifted apart in either direction.
ctx.update(dashboard_constants(ctx["INDICATORS"]))


# ==============================================================================
# PAYE - Income Tax Act 2015 (Act 896), First Schedule
#
# The GRA publishes the bands as widths ("first 490, next 110, next 130...").
# Humans think in thresholds ("tax-free up to 490, 5% up to 600..."). We store
# widths in constants.yaml and derive the thresholds here.
# ==============================================================================

_paye_widths = [
    ctx["PAYE_BAND_1_WIDTH"],
    ctx["PAYE_BAND_2_WIDTH"],
    ctx["PAYE_BAND_3_WIDTH"],
    ctx["PAYE_BAND_4_WIDTH"],
    ctx["PAYE_BAND_5_WIDTH"],
    ctx["PAYE_BAND_6_WIDTH"],
]
_paye_rates = [
    ctx["PAYE_BAND_1_RATE"],
    ctx["PAYE_BAND_2_RATE"],
    ctx["PAYE_BAND_3_RATE"],
    ctx["PAYE_BAND_4_RATE"],
    ctx["PAYE_BAND_5_RATE"],
    ctx["PAYE_BAND_6_RATE"],
]

_cumulative = Decimal("0")
for _i, _width in enumerate(_paye_widths, start=1):
    _cumulative += Decimal(str(_width))
    ctx[f"PAYE_BAND_{_i}_MAX"] = _cumulative
    ctx[f"PAYE_BAND_{_i}_MAX_ANNUAL"] = _cumulative * 12

# Where the 35% marginal rate begins (GHS/month and GHS/year)
ctx["PAYE_TOP_BAND_MIN"] = _cumulative
ctx["PAYE_TOP_BAND_MIN_ANNUAL"] = _cumulative * 12

# The whole schedule, as data. Templates and the salary calculator both use it,
# so the table on the taxes guide and the JS calculator can never disagree.
ctx["PAYE_BANDS"] = [
    {"width": w, "rate": r, "max": ctx[f"PAYE_BAND_{i}_MAX"]}
    for i, (w, r) in enumerate(zip(_paye_widths, _paye_rates), start=1)
]
ctx["PAYE_BANDS_JSON"] = json.dumps(
    [{"width": float(b["width"]), "rate": float(b["rate"])} for b in ctx["PAYE_BANDS"]]
    + [{"width": None, "rate": float(ctx["PAYE_TOP_RATE"])}]
)

# Annual tax-free allowance
ctx["PAYE_TAX_FREE_ANNUAL"] = ctx["PAYE_BAND_1_WIDTH"] * 12


# Worked examples for the salary calculator page. The same arithmetic as
# netPay() and payeOnMonthlyIncome() in templates/js/utils/tax.mjs, so the
# examples a reader sees in prose and the figures the calculator gives them for
# the same salary cannot disagree - scripts or a reviewer can check one against
# the other. The salaries are illustrative inputs, chosen to land in different
# bands; everything computed from them comes from the verified constants.
def _paye_on(taxable: Decimal) -> tuple[Decimal, list[dict]]:
    remaining, total, breakdown = max(Decimal("0"), taxable), Decimal("0"), []
    bands = [(b["width"], b["rate"]) for b in ctx["PAYE_BANDS"]] + [(None, ctx["PAYE_TOP_RATE"])]
    for width, rate in bands:
        if remaining <= 0:
            break
        amount = remaining if width is None else min(remaining, width)
        tax = amount * rate / 100
        breakdown.append({"amount": amount, "rate": rate, "tax": tax.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)})
        total += tax
        remaining -= amount
    return total, breakdown


def _worked_example(basic: int) -> dict:
    basic = Decimal(basic)
    ssnit = basic * ctx["SSNIT_EMPLOYEE_RATE"] / 100
    taxable = basic - ssnit
    paye, breakdown = _paye_on(taxable)
    net = basic - ssnit - paye
    # Half up, as the browser rounds when it formats shillings. Decimal's default is
    # half-even, which printed 2,448.12 here beside a calculator showing
    # 2,448.13 for the same salary - on a page saying the two agree.
    def cent(value: Decimal) -> Decimal:
        return value.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
    return {
        "basic": basic,
        "ssnit": cent(ssnit),
        "taxable": cent(taxable),
        "paye": cent(paye),
        "net": cent(net),
        "effective": (paye / basic * 100).quantize(Decimal("0.1")),
        "employer_ssnit": cent(basic * ctx["SSNIT_EMPLOYER_RATE"] / 100),
        "breakdown": breakdown,
    }


ctx["PAYE_WORKED_EXAMPLES"] = [_worked_example(b) for b in (3000, 6000, 12000, 30000)]
ctx["PAYE_EXAMPLE"] = ctx["PAYE_WORKED_EXAMPLES"][1]


# ==============================================================================
# SSNIT - National Pensions Act 2008 (Act 766)
# ==============================================================================

# Sanity check: the two halves must add up to the headline rate. If a budget
# changes one of them and nobody updates the other, the build stops here.
_ssnit_total = ctx["SSNIT_EMPLOYEE_RATE"] + ctx["SSNIT_EMPLOYER_RATE"]
assert _ssnit_total == ctx["SSNIT_TOTAL_RATE"], (
    f"SSNIT rates do not add up: {ctx['SSNIT_EMPLOYEE_RATE']} + "
    f"{ctx['SSNIT_EMPLOYER_RATE']} = {_ssnit_total}, expected {ctx['SSNIT_TOTAL_RATE']}"
)

_tier_total = ctx["TIER_1_RATE"] + ctx["TIER_2_RATE"]
assert _tier_total == ctx["SSNIT_TOTAL_RATE"], (
    f"Tier 1 + Tier 2 = {_tier_total}, expected {ctx['SSNIT_TOTAL_RATE']}"
)

ctx["SSNIT_MIN_CONTRIBUTION_YEARS"] = int(ctx["SSNIT_MIN_CONTRIBUTION_MONTHS"] / 12)

# The year the pension right stops growing. SSNIT starts you at 37.5% after the
# 15-year minimum and adds 1.125% a year to a 60% ceiling, so the ceiling
# arrives at 35 years - contribute past it and you buy nothing. Derived rather
# than typed, because all three inputs are constants that can move.
ctx["SSNIT_MAX_CONTRIBUTION_YEARS"] = int(
    ctx["SSNIT_MIN_CONTRIBUTION_YEARS"]
    + (ctx["SSNIT_PENSION_RIGHT_MAX"] - ctx["SSNIT_PENSION_RIGHT_MIN"])
    / ctx["SSNIT_PENSION_RIGHT_PER_YEAR"]
)

# Taking the pension before 60 reduces it permanently, by age. Assembled here
# so the guide's table and the calculator read one list - a table that says 75%
# at 57 beside a calculator that pays 80% is the failure this whole convention
# exists to prevent.
ctx["SSNIT_EARLY_FACTORS"] = [
    {"age": age, "factor": ctx[f"SSNIT_EARLY_FACTOR_{age}"]}
    for age in range(ctx["SSNIT_EARLY_PENSION_AGE"], ctx["SSNIT_PENSION_AGE"])
] + [{"age": ctx["SSNIT_PENSION_AGE"], "factor": 100}]

ctx["SSNIT_EARLY_FACTORS_JSON"] = json.dumps(
    {str(row["age"]): float(row["factor"]) for row in ctx["SSNIT_EARLY_FACTORS"]}
)

# Ghana sets a daily minimum wage, not a monthly one. This is a convenience
# figure over an average working month, and it is computed here rather than
# stored: as a constant of its own it went stale in lockstep with the daily rate
# and still read 2025's figure nine months into 2026.
WORKING_DAYS_PER_MONTH = 26
ctx["MONTHLY_MINIMUM_WAGE_APPROX"] = (ctx["DAILY_MINIMUM_WAGE"] * WORKING_DAYS_PER_MONTH).quantize(Decimal("1"))

# SSNIT contributions on the minimum wage, for the cost-of-living guide
ctx["SSNIT_EMPLOYEE_ON_MINIMUM_WAGE"] = (
    ctx["MONTHLY_MINIMUM_WAGE_APPROX"] * ctx["SSNIT_EMPLOYEE_RATE"] / 100
).quantize(Decimal("0.01"))


# ==============================================================================
# VAT - Value Added Tax Act 2025 (Act 1151), from 1 January 2026
#
# VAT, NHIL and GETFund are all charged on the same base, the value of the
# supply, so the effective rate is their plain sum. Under the 2013 Act the
# levies (with a COVID levy, since abolished) were charged first and VAT on
# top of them; this used to compound, and the site went on compounding for
# nine months after the law stopped, until the constants were checked against
# GRA on 2026-09-22.
ctx["VAT_LEVIES_TOTAL"] = ctx["NHIL_RATE"] + ctx["GETFUND_RATE"]
ctx["VAT_EFFECTIVE_RATE"] = ctx["VAT_RATE"] + ctx["VAT_LEVIES_TOTAL"]
ctx["VAT_MULTIPLIER"] = (1 + ctx["VAT_EFFECTIVE_RATE"] / 100).quantize(Decimal("0.00001"))


# ==============================================================================
# HOUSING
# ==============================================================================

# What a "12 months advance" on a mid-range one-bedroom actually costs you
# on the day you sign. This number is the reason half of Nairobi shares a room.
ctx["TYPICAL_ONE_BED_ADVANCE_TOTAL"] = (
    ctx["Nairobi_ONE_BED_RENT_MID"] * ctx["TYPICAL_RENT_ADVANCE_MONTHS"]
)
ctx["LEGAL_ONE_BED_ADVANCE_TOTAL"] = (
    ctx["Nairobi_ONE_BED_RENT_MID"] * ctx["MAX_LEGAL_RENT_ADVANCE_MONTHS"]
)
ctx["RENT_ADVANCE_EXCESS_MONTHS"] = (
    ctx["TYPICAL_RENT_ADVANCE_MONTHS"] - ctx["MAX_LEGAL_RENT_ADVANCE_MONTHS"]
)

# How many months of the median salary a typical advance swallows
ctx["ADVANCE_IN_MEDIAN_SALARIES"] = (
    ctx["TYPICAL_ONE_BED_ADVANCE_TOTAL"] / ctx["GHANA_MEDIAN_MONTHLY_EARNINGS"]
).quantize(Decimal("0.1"))


# ==============================================================================
# NHIS
# ==============================================================================

ctx["NHIS_ACTIVATION_WAIT_MONTHS"] = int(ctx["NHIS_ACTIVATION_WAIT_DAYS"] / 30)


# ==============================================================================
# DATES AND HOLIDAYS
#
# Ghana is on GMT year round. No daylight saving, no timezone arithmetic,
# which after Berlin feels like a gift.
# ==============================================================================

ctx["now"] = datetime.now(ZoneInfo("Africa/Nairobi"))
ctx["current_year"] = date.today().year
ctx["get_public_holidays"] = get_public_holidays

_holiday_years = range(date.today().year, date.today().year + 2)
ctx["PUBLIC_HOLIDAYS"] = get_public_holidays(_holiday_years)
ctx["PUBLIC_HOLIDAYS_JSON"] = json.dumps(
    [d.isoformat() for d in ctx["PUBLIC_HOLIDAYS"].keys()]
)


# ==============================================================================
# TECHNICAL
# ==============================================================================

# Where the site lives, as far as the outside world is concerned: always the
# www host, in canonicals, og:url, the sitemap, the feed, llms.txt and every
# absolute link. CANONICAL_DOMAIN is the one knob, and nothing else moves it.
#
# It used to be derived from the host Vercel injects, on the assumption that
# Vercel injects www. Then the project's primary domain became the apex, the
# apex stopped redirecting, and every page on www started declaring the apex
# canonical and linking to it 63 times - two full copies of the site, each
# claiming to be the real one, while Google had already indexed www. Search
# Console filed 76 pages as discovered and never crawled. A dashboard setting
# must not be able to move the canonical host, so it cannot any more.
#
# The apex is 308-redirected to www in vercel.json, and `mise check-deploy`
# fails if either half of that stops being true.
ctx["CANONICAL_ORIGIN"] = f"https://{env_str('CANONICAL_DOMAIN', 'www.allaboutnairobi.com')}"

# SITE_URL is the prefix on internal links. Locally it is empty, so links stay
# root-relative and `output/` works under any static server. On a deploy -
# DOMAIN set, or Vercel's VERCEL_PROJECT_PRODUCTION_URL present - links become
# absolute on the canonical origin. Which host those variables name is
# deliberately ignored; only whether they are set matters. A preview deploy
# therefore links to production, which is what it always did.
_deployed = env_str("DOMAIN") or env_str("VERCEL_PROJECT_PRODUCTION_URL")
ctx["SITE_URL"] = ctx["CANONICAL_ORIGIN"] if _deployed else ""
ctx["SITE_NAME"] = "All About Nairobi"
ctx["SITE_TAGLINE"] = "Free guides and tools for living in Nairobi"
ctx["SITE_DESCRIPTION"] = (
    "All About Nairobi offers free, independent guides and calculators for "
    "living and working in Nairobi - housing, the Ghana Card, PAYE, SSNIT, "
    "NHIS, mobile money and everything else nobody explains to you."
)
ctx["CONTACT_EMAIL"] = env_str("CONTACT_EMAIL", "allaboutnairobi@gmail.com")

# The only social account, so it is the only entry in the site's sameAs and
# the only handle Twitter cards are attributed to.
ctx["X_HANDLE"] = env_str("X_HANDLE", "aboutNairobi")
ctx["X_URL"] = f"https://x.com/{ctx['X_HANDLE']}"

# The monthly newsletter.
#
# There is no backend here, so the subscribe form has to post somewhere else.
# Which provider is a decision for whoever runs the list, not for this file, so
# it is configuration:
#
#   NEWSLETTER_ACTION   the provider's form POST URL
#   NEWSLETTER_FIELD    the field name it expects - Buttondown and Beehiiv want
#                       "email", Mailchimp "EMAIL", ConvertKit and EmailOctopus
#                       "email_address"
#   NEWSLETTER_PROVIDER a display name, for the privacy note on /terms
#
# With NEWSLETTER_ACTION unset the form degrades to a mailto: link, which is a
# real answer for a list of a few hundred people and means the page is never
# broken while a provider is being chosen.
ctx["NEWSLETTER_ACTION"] = env_str("NEWSLETTER_ACTION")
ctx["NEWSLETTER_FIELD"] = env_str("NEWSLETTER_FIELD", "email")
ctx["NEWSLETTER_PROVIDER"] = env_str("NEWSLETTER_PROVIDER", "the email service that runs the list")

# Say so, loudly, when a production build ships the fallback.
#
# The mailto: degradation is deliberate and it is not free: it asks a reader to
# open a mail client and compose a message, which most will not do on a phone.
# It is meant to cover the gap while a provider is being chosen, and it went
# unnoticed on the live site for far longer than that because nothing ever
# mentioned it. `_deployed` is set in production and empty locally, so this is
# quiet during development and audible exactly where it matters.
if _deployed and not ctx["NEWSLETTER_ACTION"]:
    logging.warning(
        "NEWSLETTER_ACTION is not set, so %s is shipping the mailto: sign-up "
        "instead of a subscribe box. Set NEWSLETTER_ACTION (and "
        "NEWSLETTER_PROVIDER) in the Vercel project settings.",
        ctx["CANONICAL_ORIGIN"],
    )

# Search Console and Bing Webmaster Tools ownership tokens. Both are optional:
# Search Console can also verify through the Google Analytics tag that is
# already on the site, and through DNS. Set them if you would rather not
# depend on either.
ctx["GOOGLE_SITE_VERIFICATION"] = env_str("GOOGLE_SITE_VERIFICATION")
ctx["BING_SITE_VERIFICATION"] = env_str("BING_SITE_VERIFICATION")
ctx["API_URL"] = env_str("API_URL", "/api")

# Google Analytics. Rendered only when SITE_URL is set, which means it fires on
# a real deployment and never on a local build - otherwise every `mise build`
# and every page you open on localhost lands in the property and quietly
# corrupts the numbers you are trying to read.
# Set GA_MEASUREMENT_ID to "" to switch it off entirely.
ctx["GA_MEASUREMENT_ID"] = env_str("GA_MEASUREMENT_ID", "G-PZ85F592NT")

# Where the support button points. Overridable so a fork can point it
# somewhere else without touching a template.
ctx["SUPPORT_URL"] = env_str("SUPPORT_URL", "https://buymeacoffee.com/allaboutnairobi")

# Microsoft Clarity. Same production-only gate as Google Analytics: recording
# your own local browsing would pollute the heatmaps and session replays with
# traffic that is not a reader.
# Set CLARITY_PROJECT_ID to "" to switch it off entirely.
ctx["CLARITY_PROJECT_ID"] = env_str("CLARITY_PROJECT_ID", "yeqkeq8vm3")

ctx["random_id"] = random_id
ctx["glossary_groups"] = glossary_groups
ctx["or_list"] = or_list

ctx["RECOMMENDED"] = Markup(
    '&nbsp;<a class="recommended" aria-label="Recommended option" '
    'title="Recommended option" href="/glossary/Recommended"></a>'
)

# CI systems usually hand us the commit directly, and their checkouts are often
# shallow or detached in ways GitPython dislikes. Prefer what they tell us.
commit_id = env_str("VERCEL_GIT_COMMIT_SHA") or env_str("GITHUB_SHA")

if not commit_id:
    try:
        import git

        commit_id = git.Repo(
            config.content_path, search_parent_directories=True
        ).head.commit.hexsha
    except Exception:
        # A fresh clone with no commits yet, or no git at all. Not worth
        # failing a build over a value that only appears in a meta tag.
        commit_id = "development"

ctx["commit_id"] = commit_id


# ==============================================================================
# URSUS
# ==============================================================================

config.site_url = ctx["SITE_URL"]
# Ursus asserts that the output path is absolute - its static asset renderer
# fails with "output_path ... is relative" partway through a build otherwise.
# Resolve here so URSUS_OUTPUT_DIR can be given as a plain relative directory,
# which is how the Vercel build script supplies it.
config.output_path = Path(
    env_str("URSUS_OUTPUT_DIR") or (Path(__file__).parent / "output")
).resolve()

# Extensionless URLs: /guides/rent-advance, not /guides/rent-advance.html.
# Caddy and `ursus -s` both resolve these.
config.html_url_extension = ""

config.minify_js = env_flag("MINIFY_JS", False)
config.minify_css = env_flag("MINIFY_CSS", True)

config.context_globals = ctx
config.jinja_filters = {
    "shillings": to_shillings,
    "usd": to_usd,
    "percent": to_percent,
    "number": to_number,
    "count": to_count,
    "compact": to_compact,
    "slug": slugify_plain,
}

# CSS is inlined through {% scss %} in _layout.html, so the standalone Sass
# renderer has nothing to do.
config.renderers.remove("ursus.renderers.sass.SassRenderer")

# Ursus 1.6.0 hands Jinja backslash-separated template names on Windows, which
# its loader rejects. See extensions/renderers/portable_jinja.py.
config.renderers[config.renderers.index("ursus.renderers.jinja.JinjaRenderer")] = (
    "extensions.renderers.portable_jinja.PortableJinjaRenderer"
)
config.renderers.append("extensions.renderers.glossary_json.GlossaryJsonRenderer")
config.renderers.append("extensions.renderers.district_stats.DistrictStatsRenderer")
config.renderers.append("extensions.renderers.nightlife_json.NightlifeJsonRenderer")
config.renderers.append("extensions.renderers.feed.AtomFeedRenderer")

# Last, and it has to be: it reads the HTML the Jinja renderer just wrote.
config.renderers.append("extensions.renderers.sitemap.SitemapRenderer")

# Dead last: it rewrites files the other renderers have already written.
config.renderers.append("extensions.renderers.asset_version.AssetVersionRenderer")

# libsass emits a BOM that silently kills the first CSS rule. See the class.
config.jinja_extensions[
    config.jinja_extensions.index("ursus.renderers.jinja.ScssLoaderExtension")
] = "extensions.renderers.jinja.PortableScssExtension"

config.jinja_extensions.extend(
    [
        "extensions.renderers.jinja.TableOfContentsExtension",
        "extensions.renderers.jinja.ToolExtension",
        "extensions.renderers.jinja.GlossaryExtension",
    ]
)

# Must run before anything reads an entry URI. See the module docstring.
config.context_processors.insert(
    0, "extensions.context_processors.portable_uris.PortableEntryUrisProcessor"
)

# Scheduled publishing. Straight after Markdown, which is what sets
# `publish_on` on an entry, and before GetEntries and RelatedEntries, which
# would otherwise index or resolve a page that is not out yet. See
# extensions/release.py.
config.context_processors.insert(
    config.context_processors.index("ursus.context_processors.markdown.MarkdownProcessor") + 1,
    "extensions.release.ReleaseProcessor",
)

config.context_processors.extend(
    [
        # Must run before the glossary processor, which copies URLs into its own
        # lookup table and would otherwise carry the backslashes with it.
        "extensions.context_processors.portable_uris.PortableEntryUrlsProcessor",
        "extensions.context_processors.collections.CollectionsProcessor",
        "extensions.context_processors.glossary.GlossaryProcessor",
        "extensions.context_processors.site_dates.SiteDatesProcessor",
        "extensions.context_processors.hero_map.HeroMapProcessor",
        "extensions.context_processors.events.EventsProcessor",
    ]
)

# Markdown links stay root-relative. BaseUrlExtension would rewrite them to
# absolute URLs, which breaks local previews.
del config.markdown_extensions["base_url"]

config.markdown_extensions["toc"]["slugify"] = patched_slugify
config.markdown_extensions["wikilinks"]["base_url"] = f"{config.site_url}/glossary/"
config.markdown_extensions["wikilinks"]["build_url"] = build_wikilinks_url
config.markdown_extensions["wikilinks"]["html_class"] = "glossary-link"
config.markdown_extensions["tasklist"]["list_item_class"] = "checkbox"
config.add_markdown_extension("markdown.extensions.attr_list")
config.add_markdown_extension("markdown.extensions.def_list")
config.add_markdown_extension("markdown.extensions.abbr")
config.add_markdown_extension(
    "extensions.markdown:WrappedTableExtension", {"wrapper_class": "table-wrapper"}
)
config.add_markdown_extension("extensions.markdown:CediExtension")
config.add_markdown_extension("extensions.release:ReleaseBlockExtension")
config.add_markdown_extension("extensions.markdown:ArrowLinkIconExtension")
config.add_markdown_extension("markdown.extensions.admonition")
config.add_markdown_extension("extensions.markdown:ExternalLinkExtension")
config.add_markdown_extension("extensions.markdown:ChecklistExtension")

config.linters = [
    "extensions.linters.constants.StaleConstantsLinter",
    "extensions.linters.constants.StaleDataFilesLinter",
    "extensions.linters.constants.UndefinedConstantsLinter",
    "extensions.linters.internal_links.InternalLinksLinter",
    "extensions.linters.glossary.GlossaryLinksLinter",
    "extensions.linters.metadata.DescriptionLinter",
    "extensions.linters.metadata.TitleLengthLinter",
    "extensions.linters.collections.CollectionCoverageLinter",
    "extensions.linters.currency.CurrencyLinter",
    "extensions.linters.release.ReleaseScheduleLinter",
    "ursus.linters.footnotes.OrphanFootnotesLinter",
    "ursus.linters.markdown.MarkdownLinkTextsLinter",
]

config.image_default_sizes = "(min-width: 800px) 800px, 100vw"
config.image_transforms = {
    "": {
        "max_size": (1600, 2400),
        "output_types": ("webp", "original"),
    },
    "content1x": {
        "include": ("images/*", "illustrations/*"),
        "exclude": ("*.svg",),
        "max_size": (800, 1200),
        "output_types": ("webp", "original"),
    },
    "content0.5x": {
        "include": ("images/*", "illustrations/*"),
        "exclude": ("*.svg",),
        "max_size": (400, 600),
        "output_types": ("webp", "original"),
    },
}

config.lunr_indexes = {
    "indexed_fields": (
        "title",
        "short_title",
        "description",
        "local_term",
        "english_term",
        "language",
    ),
    "indexes": [
        {
            "uri_pattern": "guides/*.md",
            "returned_fields": ("title", "short_title", "url"),
            "boost": 2,
        },
        {
            "uri_pattern": "tools/*.md",
            "returned_fields": ("title", "short_title", "url"),
            "boost": 2,
        },
        {
            "uri_pattern": "glossary/*.md",
            "returned_fields": ("title", "local_term", "english_term", "url"),
            "boost": 1,
        },
        {
            "uri_pattern": "newsletter/*.md",
            "returned_fields": ("title", "short_title", "url"),
            "boost": 1,
        },
        {
            "uri_pattern": "docs/*.md",
            "returned_fields": ("title", "short_title", "url"),
            "boost": 1,
        },
    ],
}

config.logging = {
    "level": getattr(logging, env_str("LOG_LEVEL", "INFO").upper(), logging.INFO),
    "format": "%(asctime)s %(levelname)s [%(name)s:%(lineno)d] %(message)s",
    "datefmt": "%H:%M:%S",
    "handlers": [logging.StreamHandler()],
}
