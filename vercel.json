{
  "buildCommand": "cd frontend && source ../.venv/Scripts/activate && ursus build",
  "outputDirectory": "frontend/output",
  "framework": "python",
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/:path*.html"
    },
    {
      "source": "/:path*/",
      "destination": "/:path*/index.html"
    }
  ]
}
